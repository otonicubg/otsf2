<title>whac-a-mole - Otonic</title><style>@font-face {
  font-family: 'Macondo';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/macondo/v27/RrQQboN9-iB1IXmOS2U.ttf) format('truetype');
}


* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: url("data:image/jpeg;base64,");
  background-size: cover;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: "Macondo", cursive;
  height: 100vh;
  overflow: hidden;
}
.grid {
  /* width: 606px;
  height: 606px;
  display: flex;
  flex-wrap: wrap;
  margin: auto; */
  display: grid;
  grid-template-columns: repeat(4, 200px);
}

.details {
  position: fixed;
  top: 10px;
  left: 10px;
  pointer-events: none;
}

.square {
  height: 200px;
  width: 200px;
  border: solid #bdbdbd 1px;
  border-radius: 50%;
}

.mole {
  background-image: url("data:image/png;base64,");
  background-size: cover;
  animation: popup 0.3s;
}

@keyframes popup {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

#hammer {
  height: 150px;
  position: absolute;
  border: 0.5px solid var(--accent);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 999999;
  pointer-events: none;
}

.snap {
  transform: translate(-50%, -50%) rotate(-45deg) !important;
}

@media (max-width: 500px) {
  #hammer {
    display: none;
  }
}
</style></head>







  
  
  


<body>

  <div class="details">
    <h2>Your score:</h2>
    <h2 id="score">0</h2>

    <h2>Time Left:</h2>
    <h2 id="time-left">60</h2>

  </div>

  <img alt="" id="hammer" data-w2s-src="/hammer.png">

  <div class="grid">
    <div class="square" id="1"></div>
    <div class="square" id="2"></div>
    <div class="square" id="3"></div>
    <div class="square" id="4"></div>
    <div class="square" id="5"></div>
    <div class="square" id="6"></div>
    <div class="square" id="7"></div>
    <div class="square" id="8"></div>
    <div class="square" id="9"></div>
    <div class="square" id="10"></div>
    <div class="square" id="11"></div>
    <div class="square" id="12"></div>

    <iframe src="bg-music.mp3" allow="autoplay" id="audio" style="display: none"></iframe>
    <audio id="player" autoplay="" loop="" muted="" data-w2s-src="/bg-music.mp3">
    <audio id="whack" data-w2s-src="/whack.mp3"></audio>
  </audio></div>

  <script>const audio = new Audio('bg-music.mp3');
    audio.play();</script>
  <script>__W2S__.inline("/app.js",{})</script>


</body></html>