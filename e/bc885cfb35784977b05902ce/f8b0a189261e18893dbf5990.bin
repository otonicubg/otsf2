			font-family: 'Noto Sans', 'Droid Sans', Arial, sans-serif;
			color: #e0e0e0;
			background-color: #3b3943;
			background-image: linear-gradient(to bottom, #403e48, #35333c);
			border: 1px solid #45434e;
			box-shadow: 0 0 1px 1px #2f2d35;
		}


		/* Status display
		 * ============== */

		#status {
			left: 0;
			top: 0;
			right: 0;
			bottom: 0;
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			display: flex;
			justify-content: center;
			align-items: center;
			/* don't consume click events - make children visible explicitly */
			visibility: hidden;
		}

		#status-progress {
			width: 250px;
			height: 30px;
			background-color: #b65555;
			border: 1px solid #c5836e;
			box-shadow: 0 0 2px 1px #693d5b;
			border-radius: 2px;
			visibility: visible;
			position: relative;
		}

		#loading-gif {
			justify-content: center;
			align-items: center;
			visibility: visible;
		}

		#loading-text {
			width: 100%;
			justify-content: center;
			align-items: center;
			visibility: visible;
			font-size: 18px;
			color: #161c2e;
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			z-index: 9;
		}

		#status-progress-inner {
			height: 100%;
			width: 0;
			box-sizing: border-box;
			transition: width 0.5s linear;
			background-color: #efe1ab;
			border: 1px solid #d5b583;
			box-shadow: 0 0 1px 1px #977b6b;
			border-radius: 2px;
			position: absolute;
			top: 0;
  			left: 0;
			z-index: 1;
		}

		#status-indeterminate {
			height: 42px;
			visibility: visible;
			position: relative;
		}

		#status-indeterminate > div {
			width: 0;
			height: 0;
			border-style: solid;
			border-width: 9px 3px 0 3px;
			border-color: #2b2b2b transparent transparent transparent;
			transform-origin: center 21px;
			position: absolute;
		}

		#status-notice {
			margin: 0 0;
			line-height: 1.3;
			visibility: visible;
			padding: 4px 6px;
			visibility: visible;
		}
	</style>
	<!-- Poki SDK include -->
	<script>__W2S__.inline("/_remote/game-cdn.poki.com/poki-sdk.js",{})</script>
	<script>



		window.addEventListener('keydown', ev => {
			if (['ArrowDown', 'ArrowUp', ' '].includes(ev.key)) {
				ev.preventDefault();
			}
		});
		window.addEventListener('wheel', ev => ev.preventDefault(), { passive: false });
	</script>

<link id="-gd-engine-icon" rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="index.apple-touch-icon.png">

