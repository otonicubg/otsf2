}


.mt60 {
    margin-top: 60px;
}


@keyframes pulseGlobal {
    0% {
        transform: scale(1, 1);
    }

    50% {
        transform: scale(1.1, 1.1);
    }

    100% {
        transform: scale(1, 1);
    }
}

.pulse-effect {
    animation: pulseGlobal 1s linear infinite;
}
