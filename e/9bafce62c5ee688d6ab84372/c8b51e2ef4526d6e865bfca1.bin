                font-size: 10px;
                padding: .25vh .5vh
            }

            #homepage .content .middle-box .skin {
                display: table;
                margin-left: auto;
                margin-right: auto
            }

            #homepage .content .middle-box .skin>div {
                display: table-cell
            }

            #homepage .content .middle-box .skin>div:last-child {
