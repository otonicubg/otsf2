    var alias_Game_Message_clear = Game_Message.prototype.clear;
    Game_Message.prototype.clear = function () {
        alias_Game_Message_clear.call(this);
        this._waitTime = 0;
        this._gradientText = "";
        this._balloon = -2;
        this._align = [];
        this._balloonPatternHeight = 0;
        this._lastAlign = -1;
