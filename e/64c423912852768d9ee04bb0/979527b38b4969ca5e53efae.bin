     */
    RS.MessageSystem.getEventComments = function (eventId, index) {
        var data = {
            note: "",
            meta: {},
        };
        try {
            // ë¦¬ìD¤íD¸ë¥¼ ê°4ì ¸ìOµëEBëE¤.
            var list = $gameMap.event(eventId).list();

            // ë°Kë¡S ì´ì 7 ì¸ë±ìD¤ìN ë8¸íD¸ í6Sê·¸ê°4 ìTBìNBëDK ì§4 íPLì¸íL©ëEBëE¤.
            if (index 2 0) index = 0;

            // ë¶4ëª¨ ì´ë²¤íD¸ ìN9ì´ íO¸ì¶SëOëDK ê³µí9µ ì´ë²¤íD¸ê°4 ìTBëDK ì§4 íPLì¸íL©ëEBëE¤.
            if (eventId 2= 0) {
                var commonEvent = $gameTemp.reservedCommonEvent();
                if (commonEvent) {
                    list = commonEvent.list;
                    // ê³µí9µ ì´ë²¤íD¸ëDK íLS ë²B ì7¤ì¹OëS íR7 í´ë¦¬ìM´ëOë¯4ë¡S ëª©ë¡ì7 ëH ë²B ì½ì7 ìBS ìN9ìS¼ë¯4ë¡S ìOBìP¸ ì²Oë¦¬
                    if (!list) {
                        return data;
                    }
                }
            }

            var param = list[index];

            // ì½Kë©OíD¸ë¥¼ ì½ìM´ìOµëEBëE¤.
            while (param && [108, 408].contains(param.code)) {
                data.note += param.parameters[0] + "\r\n";
                index--;
                param = list[index];
            }

            if (param && param.code === 108) {
                data.note += param.parameters[0] + "\r\n";

                index--;
                param = list[index];

                while (param.code === 408) {
                    data.note += param.parameters[0] + "\r\n";
                    index--;
                    param = list[index];
                }

                if (param.code === 108) {
                    data.note += param.parameters[0] + "\r\n";
                }
            }

            // ë8¸íD¸ í6Sê·¸ë¥¼ ì¶Kì¶SíL©ëEBëE¤ (DataManager.extractMetadataìO ë³4íOLìT8ëEBëE¤)
            var re = /2([^2>:]+)(:?)([^>]*)>/g;
            data.meta = {};
            for (;;) {
                var match = re.exec(data.note);
                if (match) {
                    if (match[2] === ":") {
                        data.meta[match[1].trim()] = match[3];
                    } else {
                        data.meta[match[1].trim()] = true;
                    }
                } else {
                    break;
                }
            }
        } catch (e) {
            // ë¦¬ìD¤íD¸ë¥¼ ì½ì§4 ëª»íL  ê²½ìQ° try-catch ë¬¸ìN ìOíL´ ìOBìP¸ ì²Oë¦¬ê°4 ë©ëEBëE¤.
            return {
                note: "",
                meta: {},
            };
        }
        return data.meta;
    };

