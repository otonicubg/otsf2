mandatory:!0,a:1,b:!0,description:"Contains the string to use as the chapter atom."},134:{name:"CodecID",level:3,type:"s",mandatory:!0,a:1,description:"An ID corresponding to the codec, see the codec page for more info."},136:{name:"FlagDefault",c:"TrackFlagDefault",level:3,type:"u",mandatory:!0,a:1,"default":1,range:"0-1",description:"Set if that track (audio, video or subs) SHOULD be active if no language found matches the user preference. (1 bit)"},137:{name:"ChapterTrackNumber",level:5,type:"u",
mandatory:!0,multiple:!0,a:1,b:!1,range:"not 0",description:"UID of the Track to apply this chapter too. In the absense of a control track, choosing this chapter will select the listed Tracks and deselect unlisted tracks. Absense of this element indicates that the Chapter should be applied to any currently used Tracks."},145:{name:"ChapterTimeStart",level:4,type:"u",mandatory:!0,a:1,b:!0,description:"Timestamp of the start of Chapter (not scaled)."},146:{name:"ChapterTimeEnd",level:4,type:"u",a:1,
b:!1,description:"Timestamp of the end of Chapter (timestamp excluded, not scaled)."},150:{name:"CueRefTime",level:5,type:"u",mandatory:!0,a:2,b:!1,description:"Timestamp of the referenced Block."},151:{name:"CueRefCluster",level:5,type:"u",mandatory:!0,b:!1,description:"The Position of the Cluster containing the referenced Block."},152:{name:"ChapterFlagHidden",level:4,type:"u",mandatory:!0,a:1,b:!1,"default":0,range:"0-1",description:"If a chapter is hidden (1), it should not be available to the user interface (but still to Control Tracks; see flag notes). (1 bit)"},
16980:{name:"ContentCompAlgo",level:6,type:"u",mandatory:!0,a:1,b:!1,"default":0,description:"The compression algorithm used. Algorithms that have been specified so far are: 0 - zlib,   3 - Header Stripping"},16981:{name:"ContentCompSettings",level:6,type:"b",a:1,b:!1,description:"Settings that might be needed by the decompressor. For Header Stripping (ContentCompAlgo=3), the bytes that were removed from the beggining of each frames of the track."},17026:{name:"DocType",level:1,type:"s",mandatory:!0,
"default":"matroska",a:1,description:"A string that describes the type of document that follows this EBML header. 'matroska' in our case or 'webm' for webm files."},17029:{name:"DocTypeReadVersion",level:1,type:"u",mandatory:!0,"default":1,a:1,description:"The minimum DocType version an interpreter has to support to read this file."},17030:{name:"EBMLVersion",level:1,type:"u",mandatory:!0,"default":1,a:1,description:"The version of EBML parser used to create the file."},17031:{name:"DocTypeVersion",
level:1,type:"u",mandatory:!0,"default":1,a:1,description:"The version of DocType interpreter used to create the file."},17476:{name:"SegmentFamily",level:2,type:"b",multiple:!0,a:1,b:!1,eb:16,description:"A randomly generated unique ID that all segments related to each other must use (128 bits)."},17505:{name:"DateUTC",level:2,type:"d",a:1,description:"Date of the origin of timestamp (value 0), i.e. production date."},17540:{name:"TagDefault",level:4,type:"u",mandatory:!0,a:1,b:!1,"default":1,range:"0-1",
description:"Indication to know if this is the default/original language to use for the given tag. (1 bit)"},17541:{name:"TagBinary",level:4,type:"b",a:1,b:!1,description:"The values of the Tag if it is binary. Note that this cannot be used in the same SimpleTag as TagString."},17543:{name:"TagString",level:4,type:"8",a:1,b:!1,description:"The value of the Element."},17545:{name:"Duration",level:2,type:"f",a:1,range:"> 0",description:"Duration of the segment (based on TimecodeScale)."},17816:{name:"ChapterFlagEnabled",
level:4,type:"u",mandatory:!0,a:1,b:!1,"default":1,range:"0-1",description:"Specify wether the chapter is enabled. It can be enabled/disabled by a Control Track. When disabled, the movie should skip all the content between the TimeStart and TimeEnd of this chapter (see flag notes). (1 bit)"},18016:{name:"FileMimeType",level:3,type:"s",mandatory:!0,a:1,b:!1,description:"MIME type of the file."},18017:{name:"FileUsedStartTime",level:3,type:"u",W:!0,description:"DivX font extension"},18018:{name:"FileUsedEndTime",
level:3,type:"u",W:!0,description:"DivX font extension"},18037:{name:"FileReferral",level:3,type:"b",b:!1,description:"A binary value that a track/codec can refer to when the attachment is needed."},20529:{name:"ContentEncodingOrder",level:5,type:"u",mandatory:!0,a:1,b:!1,"default":0,description:"Tells when this modification was used during encoding/muxing starting with 0 and counting upwards. The decoder/demuxer has to start with the highest order number it finds and work its way down. This value has to be unique over all ContentEncodingOrder elements in the segment."},
20530:{name:"ContentEncodingScope",level:5,type:"u",mandatory:!0,a:1,b:!1,"default":1,range:"not 0",description:"A bit field that describes which elements have been modified in this way. Values (big endian) can be OR'ed. Possible values: 1 - all frame contents, 2 - the track's private data, 4 - the next ContentEncoding (next ContentEncodingOrder. Either the data inside ContentCompression and/or ContentEncryption)"},20531:{name:"ContentEncodingType",level:5,type:"u",mandatory:!0,a:1,b:!1,"default":0,
description:"A value describing what kind of transformation has been done. Possible values: 0 - compression, 1 - encryption"},20532:{name:"ContentCompression",level:5,type:"m",a:1,b:!1,description:"Settings describing the compression used. Must be present if the value of ContentEncodingType is 0 and absent otherwise. Each block must be decompressable even if no previous block is available in order not to prevent seeking."},20533:{name:"ContentEncryption",level:5,type:"m",a:1,b:!1,description:"Settings describing the encryption used. Must be present if the value of ContentEncodingType is 1 and absent otherwise."},
21368:{name:"CueBlockNumber",level:4,type:"u",a:1,"default":1,range:"not 0",description:"Number of the Block in the specified Cluster."},22100:{name:"ChapterStringUID",level:4,type:"8",mandatory:!1,a:3,b:!0,description:"A unique string ID to identify the Chapter. Use for WebVTT cue identifier storage."},22337:{name:"WritingApp",level:2,type:"8",mandatory:!0,a:1,description:'Writing application ("mkvmerge-0.3.3").'},22612:{name:"SilentTracks",c:"ClusterSilentTracks",level:2,type:"m",a:1,b:!1,description:"The list of tracks that are not used in that part of the stream. It is useful when using overlay tracks on seeking. Then you should decide what track to use."},
25152:{name:"ContentEncoding",level:4,type:"m",mandatory:!0,multiple:!0,a:1,b:!1,description:"Settings for one content encoding like compression or encryption."},25188:{name:"BitDepth",c:"AudioBitDepth",level:4,type:"u",a:1,range:"not 0",description:"Bits per sample, mostly used for PCM."},25906:{name:"SignedElement",level:3,type:"b",multiple:!0,b:!1,description:"An element ID whose data will be used to compute the signature."},26148:{name:"TrackTranslate",level:3,type:"m",multiple:!0,a:1,b:!1,description:"The track identification for the given Chapter Codec."},
26897:{name:"ChapProcessCommand",c:"ChapterProcessCommand",level:5,type:"m",multiple:!0,a:1,b:!1,description:"Contains all the commands associated to the Atom."},26914:{name:"ChapProcessTime",c:"ChapterProcessTime",level:6,type:"u",mandatory:!0,a:1,b:!1,description:"Defines when the process command should be handled (0: during the whole chapter, 1: before starting playback, 2: after playback of the chapter)."},26916:{name:"ChapterTranslate",level:2,type:"m",multiple:!0,a:1,b:!1,description:"A tuple of corresponding ID used by chapter codecs to represent this segment."},
26931:{name:"ChapProcessData",c:"ChapterProcessData",level:6,type:"b",mandatory:!0,a:1,b:!1,description:"Contains the command information. The data should be interpreted depending on the ChapProcessCodecID value. For ChapProcessCodecID = 1, the data correspond to the binary DVD cell pre/post commands."},26948:{name:"ChapProcess",c:"ChapterProcess",level:4,type:"m",multiple:!0,a:1,b:!1,description:"Contains all the commands associated to the Atom."},26965:{name:"ChapProcessCodecID",c:"ChapterProcessCodecID",
level:5,type:"u",mandatory:!0,a:1,b:!1,"default":0,description:"Contains the type of the codec used for the processing. A value of 0 means native Matroska processing (to be defined), a value of 1 means the DVD command set is used. More codec IDs can be added later."},29555:{name:"Tag",level:2,type:"m",mandatory:!0,multiple:!0,a:1,b:!1,description:"Element containing elements specific to Tracks/Chapters."},29572:{name:"SegmentFilename",level:2,type:"8",a:1,b:!1,description:"A filename corresponding to this segment."},
29766:{name:"AttachmentLink",c:"TrackAttachmentLink",level:3,type:"u",a:1,b:!1,range:"not 0",description:"The UID of an attachment that is used by this codec."},2459272:{name:"CodecName",level:3,type:"8",a:1,description:"A human-readable string specifying the codec."},408125543:{name:"Segment",level:"0",type:"m",mandatory:!0,multiple:!0,a:1,description:"This element contains all other top-level (level 1) elements. Typically a Matroska file is composed of 1 segment."},17530:{name:"TagLanguage",level:4,
type:"s",mandatory:!0,a:1,b:!1,"default":"und",description:"Specifies the language of the tag specified, in the Matroska languages form."},17827:{name:"TagName",level:4,type:"8",mandatory:!0,a:1,b:!1,description:"The name of the Tag that is going to be stored."},26568:{name:"SimpleTag",c:"TagSimple",level:3,recursive:"1",type:"m",mandatory:!0,multiple:!0,a:1,b:!1,description:"Contains general information about the target."},25542:{name:"TagAttachmentUID",level:4,type:"u",multiple:!0,a:1,b:!1,"default":0,
description:"A unique ID to identify the Attachment(s) the tags belong to. If the value is 0 at this level, the tags apply to all the attachments in the Segment."},25540:{name:"TagChapterUID",level:4,type:"u",multiple:!0,a:1,b:!1,"default":0,description:"A unique ID to identify the Chapter(s) the tags belong to. If the value is 0 at this level, the tags apply to all chapters in the Segment."},25545:{name:"TagEditionUID",level:4,type:"u",multiple:!0,a:1,b:!1,"default":0,description:"A unique ID to identify the EditionEntry(s) the tags belong to. If the value is 0 at this level, the tags apply to all editions in the Segment."},
25541:{name:"TagTrackUID",level:4,type:"u",multiple:!0,a:1,b:!1,"default":0,description:"A unique ID to identify the Track(s) the tags belong to. If the value is 0 at this level, the tags apply to all tracks in the Segment."},25546:{name:"TargetType",c:"TagTargetType",level:4,type:"s",a:1,b:!1,strong:"informational",description:'An  string that can be used to display the logical level of the target like "ALBUM", "TRACK", "MOVIE", "CHAPTER", etc (see TargetType).'},26826:{name:"TargetTypeValue",c:"TagTargetTypeValue",
level:4,type:"u",a:1,b:!1,"default":50,description:"A number to indicate the logical level of the target (see TargetType)."},25536:{name:"Targets",c:"TagTargets",level:3,type:"m",mandatory:!0,a:1,b:!1,description:"Contain all UIDs where the specified meta data apply. It is empty to describe everything in the segment."},307544935:{name:"Tags",level:1,type:"m",multiple:!0,a:1,b:!1,description:"Element containing elements specific to Tracks/Chapters. A list of valid tags can be found here."},17677:{name:"ChapProcessPrivate",
c:"ChapterProcessPrivate",level:5,type:"b",a:1,b:!1,description:'Some optional data attached to the ChapProcessCodecID information. For ChapProcessCodecID = 1, it is the "DVD level" equivalent.'},17278:{name:"ChapCountry",c:"ChapterCountry",level:5,type:"s",multiple:!0,a:1,b:!1,description:"The countries corresponding to the string, same 2 octets as in Internet domains."},17276:{name:"ChapLanguage",c:"ChapterLanguage",level:5,type:"s",mandatory:!0,multiple:!0,a:1,b:!0,"default":"eng",description:"The languages corresponding to the string, in the bibliographic ISO-639-2 form."},
143:{name:"ChapterTrack",level:4,type:"m",a:1,b:!1,description:"List of tracks on which the chapter applies. If this element is not present, all tracks apply"},25539:{name:"ChapterPhysicalEquiv",level:4,type:"u",a:1,b:!1,description:'Specify the physical equivalent of this ChapterAtom like "DVD" (60) or "SIDE" (50), see complete list of values.'},28348:{name:"ChapterSegmentEditionUID",level:4,type:"u",a:1,b:!1,range:"not 0",description:"The EditionUID to play from the segment linked in ChapterSegmentUID."},
28263:{name:"ChapterSegmentUID",level:4,type:"b",a:1,b:!1,range:">0",eb:16,description:"A segment to play in place of this chapter. Edition ChapterSegmentEditionUID should be used for this segment, otherwise no edition is used."},29636:{name:"ChapterUID",level:4,type:"u",mandatory:!0,a:1,b:!0,range:"not 0",description:"A unique ID to identify the Chapter."},182:{name:"ChapterAtom",level:3,recursive:"1",type:"m",mandatory:!0,multiple:!0,a:1,b:!0,description:"Contains the atom information to use as the chapter atom (apply to all tracks)."},
