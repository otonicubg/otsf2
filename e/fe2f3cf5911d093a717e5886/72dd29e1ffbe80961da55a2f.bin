type:"u",a:1,"default":0,description:"Specify the possible modifications to the aspect ratio (0: free resizing, 1: keep aspect ratio, 2: fixed)."},21682:{name:"DisplayUnit",c:"VideoDisplayUnit",level:4,type:"u",a:1,"default":0,description:"How DisplayWidth & DisplayHeight should be interpreted (0: pixels, 1: centimeters, 2: inches, 3: Display Aspect Ratio)."},21690:{name:"DisplayHeight",c:"VideoDisplayHeight",level:4,type:"u",a:1,"default":"PixelHeight",range:"not 0",description:"Height of the video frames to display. The default value is only valid when DisplayUnit is 0."},
21680:{name:"DisplayWidth",c:"VideoDisplayWidth",level:4,type:"u",a:1,"default":"PixelWidth",range:"not 0",description:"Width of the video frames to display. The default value is only valid when DisplayUnit is 0."},21725:{name:"PixelCropRight",c:"VideoPixelCropRight",level:4,type:"u",a:1,"default":0,description:"The number of video pixels to remove on the right of the image."},21708:{name:"PixelCropLeft",c:"VideoPixelCropLeft",level:4,type:"u",a:1,"default":0,description:"The number of video pixels to remove on the left of the image."},
