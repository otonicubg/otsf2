position:"segment"},22743:{name:"SilentTrackNumber",c:"ClusterSilentTrackNumber",level:3,type:"u",multiple:!0,a:1,b:!1,description:"One of the track number that are not used from now on in the stream. It could change later if not specified as silent in a further Cluster."},231:{name:"Timecode",c:"ClusterTimecode",level:2,type:"u",mandatory:!0,a:1,description:"Absolute timestamp of the cluster (based on TimecodeScale)."},524531317:{name:"Cluster",level:1,type:"m",multiple:!0,a:1,description:"The lower level element containing the (monolithic) Block structure."},
