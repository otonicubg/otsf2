c:"TrackDefaultDecodedFieldDuration",level:3,type:"u",a:4,range:"not 0",description:"The period in nanoseconds (not scaled by TimcodeScale)\nbetween two successive fields at the output of the decoding process (see the notes)"},2352003:{name:"DefaultDuration",c:"TrackDefaultDuration",level:3,type:"u",a:1,range:"not 0",description:"Number of nanoseconds (not scaled via TimecodeScale) per frame ('frame' in the Matroska sense -- one element put into a (Simple)Block)."},28152:{name:"MaxCache",c:"TrackMaxCache",
