<div id="loader">
<div id="slideshow">
<div id="slideshow-top">
<img alt="Tiger Simulator 3D" id="thumbnail" title="Tiger Simulator 3D" data-w2s-src="/thumbnail.jpg">
<div id="slideshow-top-container">
<div id="game-title">
<h1>Tiger Simulator 3D</h1>
</div>
<div id="progress-container">
<div id="progress-bar">
<div id="progress-fill" style="width:0%"></div>
</div>
<div id="progress-amount">0%</div>
</div>
</div>
</div>
<div id="slideshow-images"></div>
<div id="slideshow-nav"></div>
</div>
</div>
<div id="game-container">
<div id="game"></div>
</div>
