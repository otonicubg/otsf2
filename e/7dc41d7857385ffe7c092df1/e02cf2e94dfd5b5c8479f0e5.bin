			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			animation: gmAnim 4s forwards;
			opacity: 0;
		}
        @keyframes gmAnim {
            0% {
                opacity: 0;
            }
            10% {
                opacity: 0;
            }
            25% {
                opacity: 1;
            }
            80% {
                opacity: 1;
            }
            95% {
                opacity: 0;
            }
            100% {
                opacity: 0;
                display: none;
