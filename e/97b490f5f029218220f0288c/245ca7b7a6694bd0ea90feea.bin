        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>

      </div>

      <div class="image-container">

        <a href="https://armorgames.com/?utm_source=shortURL&amp;utm_medium=link&amp;utm_term=MoreGames&amp;utm_content=home&amp;utm_campaign=ShortURL-MoreGames" target="_blank">
          <img alt="Fixed Image" id="fixed-image" height="45" width="180" data-w2s-src="/images/AG-more.png">
        </a>
        <div class="space"></div><div class="space"></div>
        <a href="https://www.facebook.com/ArmorGames/" target="_blank">
          <img alt="Fixed Image2" id="fixed-image2" height="28" width="35" data-w2s-src="/images/FB-logo.png">
        </a>
        
        <a href="https://twitter.com/ArmorGames" target="_blank">
          <img alt="Fixed Image3" id="fixed-image3" height="28" width="35" data-w2s-src="/images/TW-logo.png">
        </a>
      </div>

      <div data-keyboard="" class="keyboard">
        <!--<div class="space"></div>-->
        <button class="key" data-blanko=""></button>

        <button style="color:firebrick" class="key" data-key="A&#x2666; ">A&#x2666;</button>
        <button style="color:firebrick" class="key" data-key="A&#x2665; ">A&#x2665;</button>
        <button class="key" data-key="A&#x2663; ">A&#x2663;</button>
