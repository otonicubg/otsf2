        <button class="key" data-key="6&#x2663; ">6&#x2663;</button>
        <button class="key" data-key="6&#x2660; ">6&#x2660;</button>
        <button style="color:firebrick" class="key" data-key="5&#x2666; ">5&#x2666;</button>
        <button style="color:firebrick" class="key" data-key="5&#x2665; ">5&#x2665;</button>
        <button class="key" data-key="5&#x2663; ">5&#x2663;</button>
        <button class="key" data-key="5&#x2660; ">5&#x2660;</button>
        <button style="color:firebrick" class="key" data-key="4&#x2666; ">4&#x2666;</button>
        <button style="color:firebrick" class="key" data-key="4&#x2665; ">4&#x2665;</button>
        <button class="key" data-key="4&#x2663; ">4&#x2663;</button>
        <button class="key" data-key="4&#x2660; ">4&#x2660;</button>
        <button style="color:firebrick" class="key" data-key="3&#x2666; ">3&#x2666;</button>
        <button style="color:firebrick" class="key" data-key="3&#x2665; ">3&#x2665;</button>
        <button class="key" data-key="3&#x2663; ">3&#x2663;</button>
        <button class="key" data-key="3&#x2660; ">3&#x2660;</button>
        <button style="color:firebrick" class="key" data-key="2&#x2666; ">2&#x2666;</button>
        <button style="color:firebrick" class="key" data-key="2&#x2665; ">2&#x2665;</button>
        <button class="key" data-key="2&#x2663; ">2&#x2663;</button>
        <button class="key" data-key="2&#x2660; ">2&#x2660;</button>
        

        <button class="key" data-delete=""></button>

        <button class="key" data-enter="">ENTER</button>
        

      </div>

      <div data-scoreboard1-grid="" class="scoreboard1-grid">
        <button onclick="toggleGameMusic()" style="background: transparent; border: none;">
          <img id="musicImage" alt="Music Image" class="music-icon" data-w2s-src="/images/music-off.png">
        </button>
        <br>
        <button onclick="toggleGameSound()" style="background: transparent; border: none;">
          <img id="soundImage" alt="Sound Image" class="sound-icon" data-w2s-src="/images/sound-on.png">
        </button>
        <div class="space"></div><div class="space"></div>
        <button class="key" data-reload="">NEW GAME</button>

        <div class="rules-container">
          <button id="rulesButton" class="key" data-rules="">RULES</button>
          <div id="rulesPopup" class="rules">
            <div class="close-button" id="closeButton">X</div>
            <!-- Rules content here -->
          </div>
        </div>
      </div>
      <div data-scoreboard2-grid="" class="scoreboard2-grid">
        <div id="score"></div>
        <div id="lives"></div>
        <div id="level"></div>
        <button id="creditButton" class="key" data-credit="">C R E D I T</button>
          <div id="creditPopup" class="credit">
            <div class="close2-button" id="close2Button">X</div>
            <!-- Credit content here -->
          </div>
      </div>
  </div>    
