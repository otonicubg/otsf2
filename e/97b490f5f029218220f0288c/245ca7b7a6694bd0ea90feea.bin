        <button class="key" data-key="J&#x2663; ">J&#x2663;</button>
        <button class="key" data-key="J&#x2660; ">J&#x2660;</button>
        <button style="color:firebrick" class="key" data-key="10&#x2666;">10&#x2666;</button>
        <button style="color:firebrick" class="key" data-key="10&#x2665;">10&#x2665;</button>
        <button class="key" data-key="10&#x2663;">10&#x2663;</button>
        <button class="key" data-key="10&#x2660;">10&#x2660;</button>
