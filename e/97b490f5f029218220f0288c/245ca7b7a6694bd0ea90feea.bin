<body>
  <div class="intro">
    <a href="https://armorgames.com/?utm_source=shortURL&amp;utm_medium=link&amp;utm_term=MoreGames&amp;utm_content=home&amp;utm_campaign=ShortURL-MoreGames" target="_blank">
      <video id="intro-video" autoplay="" muted="" playsinline="" height="590" width="885">
        <source type="video/mp4" data-w2s-src="/_remote/files.armorgames.com/648x432_v1.m4v">
        <source type="video/ogg" data-w2s-src="/_remote/files.armorgames.com/648x432_v1.ogv">
      </video>
    </a>
  </div>
  <div class="screen">
      <div class="alert-container" data-alert-container=""></div>
      <audio id="musicTheme" data-w2s-src="/sound/handle-theme.mp3"></audio>
      <audio id="applauseSound" data-w2s-src="/sound/applause.ogg"></audio>
      <audio id="gameOverSound" data-w2s-src="/sound/game-over.mp3"></audio>
      <audio id="openSound" data-w2s-src="/sound/open.ogg"></audio>
      <audio id="deathSound" data-w2s-src="/sound/death.ogg"></audio>

      <div data-hand_grid="" class="hand_grid">
        <div id="card1"></div>
        <div id="card2"></div>
        <div id="card3"></div>
        <div id="card4"></div>
        <div id="card5"></div>
        <div id="info"></div>
      </div>
      <div data-guess-grid="" class="guess-grid">
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
