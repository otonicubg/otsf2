}

div#stores:before, div#weapons:before {
	position: absolute;
	background: white;
	content: attr(data-legend);
	left: 8px;
	top: -13px;
}

div#stores {
	position: relative;
	z-index:10;
	border: 1px solid black;
	cursor: default;
	padding: 5px 10px;
	width: 200px;
}

div.storeRow {
	position: relative;
}

div#weapons {
	margin-top: 15px;
	position: relative;
