<body>

  <img id="coolMathSplash" data-w2s-src="/images/handling/coolMathSplash.png">

  <div id="backgroundDiv"></div>

<div id="gameDiv" style="display: none;">

  <div id="resIconDiv">
    <div id="resIconWrapper">
      <img alt="wood" data-w2s-src="/images/icons/wood.png">
      <p id="wood">0</p>
      <img alt="gold" data-w2s-src="/images/icons/gold.png">
      <p id="gold">0</p>
      <img alt="coco" data-w2s-src="/images/icons/coco.png">
      <p id="coco">0</p>
      <img alt="stardust" data-w2s-src="/images/icons/stardust.png">
      <p id="stardust">0</p>
      <div class="floatRight">
        <img style="margin-right: 10px; margin-top: 4px; width: 60%" onclick="toggleSettings()" data-w2s-src="/images/icons/settings.png">
      </div>
    </div>
  </div>

  <div class="fullWidth" id="resInfoDiv">
    <div id="infoContentHolder">
      <img alt="wood per second" data-w2s-src="/images/icons/wood.png">
      <p id="woodSec">+0/s</p>
      <img alt="gold per second" data-w2s-src="/images/icons/gold.png">
      <p id="goldSec">+0/s</p>
      <img alt="coco per second" data-w2s-src="/images/icons/coco.png">
      <p id="cocoSec">+0/s</p>
      <div class="floatRight" id="ghostCounter">
        <img alt="ghosts" data-w2s-src="/images/icons/ghost.png">
        <p id="ghostCount">0</p>
      </div>
      <div class="floatRight" id="ringCounter">
        <img alt="space rings" data-w2s-src="/images/icons/lollipop.gif">
        <p id="ringCount">0</p>
      </div>
    </div>

  </div>

  <div class="bodyWrapper" id="bWrapper">

  <div id="almostBlackground"></div>

    <br>
    <br>
    <br>

    <div class="fullWidth" id="artDiv">
      <h1 id="dungeonLevel"></h1>
      <h1 id="settingsHeadline">Settings</h1>
      <div class="blackCover">
        <div class="derekArt" id="derekDiv">
          <img class="derekImg" style="z-index: 10;" id="legsImg" data-w2s-src="/images/handling/invisibleImg.gif">
          <img class="derekImg" style="z-index: 11;" id="headImg" data-w2s-src="/images/handling/invisibleImg.gif">
          <img class="derekImg" style="z-index: 12;" id="fistImg" data-w2s-src="/images/handling/invisibleImg.gif">
          <img class="derekImg" id="derekBlackImg" data-w2s-src="/images/handling/derekBlack.gif">
        </div>
        <img id="handlingArt" data-w2s-src="/images/handling/planet.gif">
      </div>
      <img id="settingsArt" data-w2s-src="/images/handling/tinyImg.gif">
<!--       <img src="images/backgrounds/BlackCover.png" id="blackCover"> -->
    </div>

  	<div class="fullWidth" id="textDiv">

      

      <div class="handlingBlackCover">
        <div class="textHolder">
          <p id="resCounter"></p>
          <p id="handling"></p>
        </div>
      </div>
  		
      <p id="settingsHandling"></p>

      <div id="loading_container"></div>

  		<div id="buttons">

  		</div>



      <div id="settingsButtons">

      </div>

    <div class="fullWidth">
      <br>
      <br>
    </div>

  	</div>

  </div>

</div>

