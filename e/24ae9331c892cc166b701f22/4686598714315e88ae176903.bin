	padding:0px;
	position:absolute;
	height:100vh;
	width:100vw;
	background-color:#f0f0f1;
}

#gameContainer,canvas{
	position:absolute;
	height:100%;
	width:100%;
	background-color:#f0f0f1;
}
#gameCanvas
{
     margin-left:15%;
     margin-right:15%;
	 max-width: 70%;
}
#fullScreenButton{
	height:50px;
	width:50px;
	position:absolute;
	z-index:1;
	bottom:5px;
	right:5px;
	background-color:transparent;
	background-image:url("../img/fullScreen_on.png");
	background-repeat: no-repeat;
	background-position: center;
	background-size:30px 30px;
	border:none;
	cursor: pointer;
}

.subtitle{
	color:#1896a7;
	font-size:2.3vh;
	padding-bottom:2.3vh;
	padding-top:2.5vh;
	display: block;
	height:20vh;
	width:40vw;
	margin:auto;
	text-align: center;
}

.logo{
	height:25vh;
	width:auto;
	display: block;
	margin:auto;
	margin-top:2vh;
}

#loadingBlock,#errorBrowserBlock{
	background-image:url("data:image/png;base64,");
	background-size:cover;
}

#emptyBar{
	background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAwIAAAAGCAYAAABwxSkzAAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAAE5JREFUeNrs17ENgDAQBEGM6L8lmgEH2AHOX4JCbqaEzba9a50bAAAQpV13/2QAAIAsxxyPCgAAkDYCVaUCAACE2SUAAAAjAAAABPgFGACbog0DGKlpZQAAAABJRU5ErkJggg==") no-repeat right;
	float: right; 
	width: 60%; 
	height: 100%; 
	display: inline-block;
}

#fullBar{
	background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAwIAAAAGCAYAAABwxSkzAAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAAFNJREFUeNrs1zENgDAARFEgFYY0TFRP904dq4LA3AV83HvJGfjb7fOqbQMAAKKUf6cMAAAQdgTePlQAAIC0I7DuRwUAAAhzSAAAAI4AAAAQ4BNgAFmmCGKj2bV2AAAAAElFTkSuQmCC") no-repeat right;
	float: left; 
	width: 40%; 
	height: 100%; 
	display: inline-block;
}

#progressBar,#warningBrowserBlock,#warningMobileBlock,#errorContent{
	height:25vh;
	width:40vw;
	margin:auto;
	text-align: center;
}

#progressBar{
	height:8vh;
	color:#666666;
	font-size:4vh;
}

#warningBrowserBlock,#warningMobileBlock,#errorContent{
	margin-top:15vh;
	color:#666666;
	font-size:2.3vh;
}

.browserIcons{
	display: inline-flex;
	margin-top:2vh;
}

.browserIcons a{
	width:150px;
}

#errorContent{
	font-size:3vh;
	margin-top:5vh;
}

.centered{
	height: 100%;
	max-width:770px;
	margin-left:auto;
	margin-right:auto;
}


