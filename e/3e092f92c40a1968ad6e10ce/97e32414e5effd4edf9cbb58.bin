22%20%2F%3E%0D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Crect%20width%3D%2272%22%20height%3D%2272%22%20fill%3D%22white%22%20%2F%3E%0D%0A%20%20%20%20%20%20%20%20%3C%2Fdefs%3E%0D%0A%20%20%20%20%3C%2Fg%3E%0D%0A%3C%2Fsvg%3E"><link rel="manifest" href="data:application/json;base64,"><meta name="msapplication-TileColor" content="#ffffff"><meta name="msapplication-TileImage" content="resources/icons/ms-icon-144x144.png"><meta name="theme-color" content="#ffffff"><script>__W2S__.inline("/resources/js/base-error-reporting.js",{})</script><script>__W2S__.inline("/resources/js/surf-error-reporting.js",{})</script><script>__W2S__.inline("/resources/js/assert.js",{})</script><script>__W2S__.inline("/resources/js/promise_resolver.js",{})</script><script>__W2S__.inline("/resources/js/cr.js",{})</script><script>__W2S__.inline("/resources/js/parse_html_subset.js",{})</script><script>__W2S__.inline("/resources/js/load_time_data.js",{})</script><script>__W2S__.inline("/resources/js/util.js",{})</script><script>__W2S__.inline("/resources/js/strings.js",{})</script><script src="/js/main.js"></script><style media="all">/** Copyright (C) Microsoft Corporation. All rights reserved.
