<script type="module">
  import games from "../cards-data.js";
  import { siteMapping } from "../site-mapping.js";

  document.addEventListener("DOMContentLoaded", function () {
    const cardContainer = document.getElementById("cardContainer");

    // Function to get the Page 1 host and protocol based on current host
    function getPage1HostAndProtocol() {
      const currentHost = window.location.hostname;

      // Iterate over the siteMapping to find the current host as a value
      for (const [page1Host, page2URL] of Object.entries(siteMapping)) {
        try {
          const page2URLObj = new URL(page2URL);
          const page2Host = page2URLObj.hostname;
          const protocol = page2URLObj.protocol; // e.g., 'http:' or 'https:'

          if (page2Host === currentHost) {
            return { page1Host, protocol };
          }
        } catch (error) {
          console.error(`Invalid URL in siteMapping: ${page2URL}`, error);
        }
      }
      return null;
    }

    function adjustHrefPath(path, page) {
      // Remove leading './' or '/' from the path
      path = path.replace(/^\.\//, "").replace(/^\//, "");

      if (page === undefined || page != 2) {
        // For Page 1 games
        const page1Info = getPage1HostAndProtocol();
        if (page1Info) {
          const { page1Host, protocol } = page1Info;
          const adjustedFirstPageLink =
            protocol + "//" + page1Host.replace(/\/$/, "");
          const adjustedPath = "/" + path;
          return adjustedFirstPageLink + adjustedPath;
        } else {
          // If currentHost not found in siteMapping values, log an error
          console.error(
            `Current host not found in siteMapping values. Unable to adjust href for Page 1 game.`
          );
          return "#"; // Fallback href
        }
      } else {
        // For Page 2 games, adjust the path to go back two directories
        return "../" + path;
      }
    }

    function adjustImgPath(path, page) {
      // Remove leading './', '/', or 'img/' from the path
      path = path
        .replace(/^\.\//, "")
        .replace(/^\//, "")
        .replace(/^img\//, "");

      if (page === undefined || page != 2) {
        // For Page 1 games, get image from the first page link
        const page1Info = getPage1HostAndProtocol();
        if (page1Info) {
          const { page1Host, protocol } = page1Info;
          const adjustedFirstPageLink =
            protocol + "//" + page1Host.replace(/\/$/, "");
          const adjustedPath = "/img/" + path;
          return adjustedFirstPageLink + adjustedPath;
        } else {
          // If currentHost not found in siteMapping values, log an error
          console.error(
            `Current host not found in siteMapping values. Unable to adjust image path for Page 1 game.`
          );
          return "../img/" + path; // Fallback to local image
        }
      } else {
        // For Page 2 games, adjust the path to go back two directories
        return "../img/" + path;
      }
    }

    function getCardHTML(gameObject) {
      const { href, imgSrc, name, page } = gameObject;

      // Adjust the href and imgSrc paths
      const adjustedHref = adjustHrefPath(href, page);
      const adjustedImgSrc = adjustImgPath(imgSrc, page);

      // Create the card element
      const card = document.createElement("a");
      card.className = "card";
      card.href = adjustedHref;

      const img = document.createElement("img");
      img.src = adjustedImgSrc;
      img.alt = name;
      card.appendChild(img);

      const figcaption = document.createElement("figcaption");
      figcaption.textContent = name;
      card.appendChild(figcaption);

      return card;
    }

    // Generate and display random recommended games
    const randomGames = games.sort(() => 0.5 - Math.random()).slice(0, 10);
    randomGames.forEach((game) => {
      const card = getCardHTML(game);
      cardContainer.appendChild(card);
    });
  });
</script>
  

</body></html>