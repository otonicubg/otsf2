#openTutorialContainer{
	position: absolute;
	top: 70%;
	left: -5%;
}

#openTutorialContainer2{
	position: absolute;
	top: 35%;
	left: 60.5%;
	z-index: 1;
}

.tutorialStar.flashing{
    animation: flashingStar 1.2s infinite;
}
@keyframes flashingStar{
    0%{color: gold;}
    49%{color: gold;}
    60%{color: red;}
    99%{color: red;}
    100%{color: gold;}
}

#tutorialDiv{
	position: absolute;
	top: 50%;
	left: 70%;
	width: 30vw;
	height: calc(50vh - 40px);
	background-color: rgba(0, 0, 0, 0.8);
	padding: 1vh;
	color: white;
	font-size: 1.2vw;
	z-index: 4;
}

#tutorialDiv.tutorialWidth{
	left: 70%;
	width: 30vw;
}

#tutorialDiv.tutorialWidthLg{
	left: 50%;
	width: 50vw;
	background-color: rgb(0,0,0);
}

#tutorialDiv.tutorialDivSm{
	top: 60%;
	height: calc(40vh - 40px);
}

#tutorialText{
	font-size: 0.9vw;
	position: relative;
