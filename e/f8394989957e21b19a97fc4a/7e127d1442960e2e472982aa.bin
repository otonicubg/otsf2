	height: 4.8vw;
	z-index: 2;
	color: #3f3f3f;
	font-size: 1vw;
	text-align: center;
	border-radius: 25px;
	border: 4px outset #536373;
	display: none;
	background-color: #dcdcdc;
}

#achievementTrackerIconContainer{
