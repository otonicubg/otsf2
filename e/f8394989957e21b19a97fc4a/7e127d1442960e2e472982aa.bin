	border: 1px solid black !important;
	cursor: pointer;
	text-align: center;
	width: 100%;
}

.settingsBtnConfig {
	width: 83%;
	border-right: none !important;
}

.settingsBtnConfig + button { 
	width: 17%;
	background: gray;
	font-size: 1.25vw;
	border: 1px solid black ;
	border-left: none;
	cursor: pointer;
}

.settingsBtnConfig + button > span {
	top: .2vw !important;
}

