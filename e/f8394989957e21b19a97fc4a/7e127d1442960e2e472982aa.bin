<div class="noselect heirloomBtnActive heirBtn" id="unequipHeirloomBtn" onclick="unequipHeirloom()">Unequip</div>
<div class="noselect heirloomBtnActive heirBtn" id="heirloomPortalBtn" onclick="toggleHeirloomOnPortal()">Equip on Portal</div>
</div>
</div>
<div id="carriedHeirlooms">
					Carried <span id="carriedHeirloomsText"></span>
<div id="carriedHeirloomsHere"></div>
<div class="heirloomBtnGroup" id="carriedHeirloomsBtnGroup" style="visibility: hidden">
<div class="noselect heirloomBtnActive heirBtn" id="equipHeirloomBtn" onclick="equipHeirloom()">Equip</div>
<div class="noselect heirloomBtnActive heirBtn" id="stopCarryHeirloomBtn" onclick="stopCarryHeirloom()">Stop Carrying</div>
</div>
</div>
<div id="extraHeirlooms">
					Temporary <span id="extraHeirloomsText"></span> <div class="heirloomBtnActive heirBtn noselect" id="recycleAllHeirloomsBtn" onclick="recycleAllHeirloomsClicked()">Recycle All</div>&nbsp;<div class="heirloomBtnActive heirBtn noselect" id="sortHeirloomsBtn" onclick="sortHeirlooms()">Sort</div>
<div id="extraHeirloomsHere"></div>
<div class="heirloomBtnGroup" id="extraHeirloomsBtnGroup" style="visibility: hidden">
<div class="noselect heirloomBtnActive heirBtn" id="equipHeirloomBtn2" onclick="equipHeirloom()">Equip</div>
<div class="noselect heirloomBtnActive heirBtn" id="carryHeirloomBtn" onclick="carryHeirloom()">Carry</div>
<div class="noselect heirloomBtnActive heirBtn" id="recycleHeirloomBtn" onclick="recycleHeirloom()">Recycle</div>
</div>
</div>
</div>
