<div id="outerBuyContainer">
<div id="buyTabs">
<ul class="nav nav-tabs nav-justified buyTabsUl" id="buyTabsUl">
<li class="tabNotSelected buyTab" id="allTab" onclick="filterTabs('all')" role="presentation"><a id="allA">All</a></li>
<li class="tabNotSelected buyTab" id="buildingsTab" onclick="filterTabs('buildings')" role="presentation"><a id="buildingsA"><span class="alert badge" id="buildingsAlert"></span>Buildings</a></li>
<li class="tabNotSelected buyTab" id="jobsTab" onclick="filterTabs('jobs')" role="presentation" style="visibility: hidden"><a id="jobsA"><span class="alert badge" id="jobsAlert"></span>Jobs</a></li>
<li class="tabNotSelected buyTab" id="upgradesTab" onclick="filterTabs('upgrades')" role="presentation" style="visibility: hidden"><a id="upgradesA"><span class="alert badge" id="upgradesAlert"></span>Upgrades</a></li>
<li class="tabNotSelected buyTab" id="equipmentTab" onclick="filterTabs('equipment')" role="presentation" style="visibility: hidden"><a id="equipmentA"><span class="alert badge" id="equipmentAlert"></span>Equipment</a></li>
