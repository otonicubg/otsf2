.selectedHeirloomItem.heirloomRare12{
	font-size: 1.35vw;
}

.rarityBdBox.heirloomRare12, .heirloomRare12{
    color: #fff;
	text-shadow: 0.05vw 0.05vw 0.05vw #660066, -0.05vw 0.05vw 0.05vw #003300, 0.05vw -0.05vw 0.05vw #003399, -0.05vw -0.05vw 0.05vw #003399, 0.15vw 0.15vw 0.15vw #660066, -0.15vw 0.15vw 0.15vw #003300, 0.15vw -0.15vw 0.15vw #003399, -0.15vw -0.15vw 0.15vw #003399,5px 5px 1.4vw black, 5px -5px 1.4vw black, -5px 5px 1.4vw black, -5px -5px 1.4vw black;
}

.specDesc12{
	color: #fff;
}

.heirloomRare12 .heirloomMod:hover, .heirloomRare12.rarityBdBox{
	border: 0.2vw solid #fff;
}

.heirloomRare12 .heirloomMod{
	background-color: initial;
}

.selectedHeirloomItem.heirloomRare12{
	background: linear-gradient(35deg,  #000 0%, #660066 20%, #003300 40%, #003399 60%,#ff9900 80%, #000 100%); 
}

.heirloomRare12.heirloomThing, .heirloomRare12 div .selectedHeirloomIcon, .rarityBdBox.heirloomRare12 {
    color: #fff;
	text-shadow: 0.05vw 0.05vw 0.05vw #660066, -0.05vw 0.05vw 0.05vw #003300, 0.05vw -0.05vw 0.05vw #003399, -0.05vw -0.05vw 0.05vw #ff9900, 0.15vw 0.15vw 0.15vw #660066, -0.15vw 0.15vw 0.15vw #003300, 0.15vw -0.15vw 0.15vw #003399, -0.15vw -0.15vw 0.15vw #ff9900,5px 5px 1.4vw black, 5px -5px 1.4vw black, -5px 5px 1.4vw black, -5px -5px 1.4vw black;
