	}
	100% {
		text-shadow: 0.05vw 0.05vw 0.05vw #660066, -0.05vw 0.05vw 0.05vw #003300, 0.05vw -0.05vw 0.05vw #003399, -0.05vw -0.05vw 0.05vw #ff9900, 0.15vw 0.15vw 0.15vw #660066, -0.15vw 0.15vw 0.15vw #003300, 0.15vw -0.15vw 0.15vw #003399, -0.15vw -0.15vw 0.15vw #ff9900,5px 5px 1.4vw black, 5px -5px 1.4vw black, -5px 5px 1.4vw black, -5px -5px 1.4vw black;
