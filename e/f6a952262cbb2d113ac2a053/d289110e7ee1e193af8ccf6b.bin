<content itemscope="" itemtype="https://schema.org/VideoGame">
<h1 itemprop="name">Gold Digger FRVR</h1>
<meta content="https://golddigger.frvr.com/" itemprop="url">
<div itemprop="author" itemscope="" itemtype="http://schema.org/Organization">
<p style="margin-top:0px"><span itemprop="name"><a href="http://frvr.com/" itemprop="url">By FRVR</a></span>
</p>
</div>
<metadata>
<!--<img itemprop="image" src="" data-original="./v/1576154523809/i/web/icon196x196.png"/>-->
<meta content="SinglePlayer" itemprop="playMode">
