");
	background-size:cover;
}

#emptyBar{
	background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAwIAAAAGCAYAAABwxSkzAAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAAE5JREFUeNrs17ENgDAQBEGM6L8lmgEH2AHOX4JCbqaEzba9a50bAAAQpV13/2QAAIAsxxyPCgAAkDYCVaUCAACE2SUAAAAjAAAABPgFGACbog0DGKlpZQAAAABJRU5ErkJggg==") no-repeat right;
	float: right; 
	width: 60%; 
	height: 100%; 
	display: inline-block;
}

#fullBar{
	background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAwIAAAAGCAYAAABwxSkzAAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAAFNJREFUeNrs1zENgDAARFEgFYY0TFRP904dq4LA3AV83HvJGfjb7fOqbQMAAKKUf6cMAAAQdgTePlQAAIC0I7DuRwUAAAhzSAAAAI4AAAAQ4BNgAFmmCGKj2bV2AAAAAElFTkSuQmCC") no-repeat right;
	float: left; 
	width: 40%; 
	height: 100%; 
	display: inline-block;
}

#progressBar,#warningBrowserBlock,#warningMobileBlock,#errorContent{
	height:25vh;
	width:40vw;
	margin:auto;
	text-align: center;
}

#progressBar{
	height:8vh;
	color:#666666;
	font-size:4vh;
}

#warningBrowserBlock,#warningMobileBlock,#errorContent{
	margin-top:15vh;
	color:#666666;
	font-size:2.3vh;
}

.browserIcons{
	display: inline-flex;
	margin-top:2vh;
}

.browserIcons a{
	width:150px;
}

#errorContent{
	font-size:3vh;
	margin-top:5vh;
}

.centered{
	height: 100%;
	max-width:770px;
	margin-left:auto;
	margin-right:auto;
}


