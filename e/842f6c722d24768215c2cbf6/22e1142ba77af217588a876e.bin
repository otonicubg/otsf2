<title>balloons.io - Otonic</title>

<meta content="The game files for Air Toons, a free browser game on CrazyGames.com" name="description">

<meta content="DPR" http-equiv="Accept-CH">
<meta content="width=device-width, maximum-scale=1.0, initial-scale=1.0, user-scalable=no, minimal-ui" name="viewport">
<style id="ziggyLoaderStyles">
    html {
      width: 100%;
      height: 100%;
      position: relative;
    }

    body {
      width: 100%;
      height: 100%;
      position: relative;
      background-color: #13141E;
      overflow: hidden;
    }

    .ziggyLoader {
      width: 100%;
      height: 100%;
      position: relative;
    }

    .container {
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      flex-direction: column;
      width: 100%;
      height: 100%;
      color: #F9FAFF;
      font-family: 'Nunito', Arial, "Helvetica Neue", Helvetica, sans-serif;
      font-style: normal;
      font-weight: 400;
      font-size: 14px;
      position: absolute;
      z-index: 3;
      opacity: 0.5;
    }

    @keyframes bob {
      0% {
        transform: translate(0px, 0px);
      }

      50% {
        transform: translate(0px, 10.5px);
      }

      100% {
        transform: translate(0px, 0px);
      }
    }
  </style>
</head>
