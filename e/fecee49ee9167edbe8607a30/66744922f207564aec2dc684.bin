<body class="bg-apple-lightgray text-apple-dark">
    <header class="fixed top-0 left-0 right-0 z-50 bg-gradient-to-r from-[#4A90B9] to-[#6CB2D6] text-white p-4 md:p-6 shadow-md rounded-b-3xl">
        <div class="container mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="text-center md:text-left mb-4 md:mb-0">
                    <h1 class="text-3xl md:text-4xl font-bold text-shadow">Baseball Bros: Browser Baseball Game 2025</h1>
                </div>
                <nav class="md:ml-8">
                    <ul class="flex space-x-6">
