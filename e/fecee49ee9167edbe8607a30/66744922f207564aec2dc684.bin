                        <iframe data-src="https://baseballbrosio.io/game/baseball-bros/" class="absolute top-0 left-0 w-full h-full opacity-0 transition-opacity duration-300" loading="lazy" decoding="async" title="Play Baseball Bros Unblocked" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen="" onload="this.classList.add('opacity-100'); this.previousElementSibling.style.display='none';">
