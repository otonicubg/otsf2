		<title>Deadseat - Otonic</title>
		<style>
			html,
			body,
			#canvas {
				margin: 0;
				padding: 0;
				border: 0;
			}

			body {
				color: white;
				background-color: black;
				overflow: hidden;
				touch-action: none;
			}

			#canvas {
				display: block;
			}

			#canvas:focus {
				outline: none;
			}

			#status,
			#status-splash,
			#status-progress {
				position: absolute;
				left: 0;
				right: 0;
