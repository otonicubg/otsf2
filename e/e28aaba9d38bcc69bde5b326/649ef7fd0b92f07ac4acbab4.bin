#lumps
{
	display:none;
	position:absolute;
	width:32px;
	height:32px;
	position:absolute;
	z-index:10000;
	left:-8px;
	bottom:-12px;
	z-index:10000;
	cursor:pointer;
	filter:drop-shadow(0px 3px 2px #000);
	-webkit-filter:drop-shadow(0px 3px 2px #000);
}
#lumps:hover #lumpsIcon,#lumps:hover #lumpsIcon2
{top:-10px;}
#lumpsIcon,#lumpsIcon2
{
	width:48px;
	height:48px;
