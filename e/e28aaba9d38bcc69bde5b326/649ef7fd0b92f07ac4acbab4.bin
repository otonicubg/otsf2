.parentLink
{
	/*background:url("data:image/png;base64,");*/
	background:url("data:image/gif;base64,");
	width:0px;
	height:8px;
	position:absolute;
	-ms-transform-origin:0% 50%;
	-webkit-transform-origin:0% 50%;
	transform-origin:0% 50%;
