                    -webkit-transform: scale(0.6) translateZ(0);
                    transform: scale(0.6) translateZ(0);
                }
                #sideadlol {
                    right: 198px;
                    top: 19px;
                    /*max-height: 480px;*/
                    width: 120px !important;
