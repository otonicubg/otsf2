                }
            }

            @media screen and (max-height: 600px) and (max-width: 900px) {
                #wrapper {
                    width: 649px;
                    -webkit-transform: scale(0.6) translateZ(0);
                    transform: scale(0.6) translateZ(0);
                }
                #tabs {
                    width: 577px;
