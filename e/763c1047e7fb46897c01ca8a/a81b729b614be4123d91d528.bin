			animation: gmAnim 4s forwards;
			opacity: 0;
		}
        @keyframes gmAnim {
            0% {
                opacity: 0;
            }
            10% {
                opacity: 0;
            }
            25% {
                opacity: 1;
            }
            80% {
                opacity: 1;
            }
            95% {
                opacity: 0;
            }
            100% {
                opacity: 0;
                display: none;
            }
        }
        @keyframes gmbAnim {
            0% {
                opacity: 1;
            }
            80% {
                opacity: 1;
            }
            99% {
                opacity: 0;
            }
            100% {
                opacity: 0;
                display: none;
            }
        }
	`
	document.head.appendChild(style)

	const intro = document.createElement('div')
	intro.classList.add("gm-intro")

	const image = document.createElement('img')
	image.src = "data:image/png;base64,"
	image.classList.add("gm-logo")
	intro.appendChild(image)

	document.body.appendChild(intro)

	setTimeout(() => {
		document.body.removeChild(intro)
	}, 4100)
})

}catch(_e){}}
