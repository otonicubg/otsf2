							<stat-item :loc="loc" :stat="{'name': 'stat_private', 'lifetime': [statsLifetime.kills.mode.private, statsLifetime.deaths.mode.private], 'current': [statsMonthly.kills.mode.private, statsMonthly.deaths.mode.private] }"></stat-item>
