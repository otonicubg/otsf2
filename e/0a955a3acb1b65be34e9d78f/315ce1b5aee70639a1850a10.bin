		</div>
		<div class="content-wrap f_col f_space_between">
			<p>{{ item.title }}</p>
			<p v-if="item.desc">{{ item.desc }}</p>
			<p class="text-right">{{ item.author }}</p>
		</div>
	</article>
</script>
