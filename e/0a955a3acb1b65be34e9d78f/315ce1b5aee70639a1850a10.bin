}

.discord .tool-tip div.tool-tip--bubble:after {
  left: 68%;
}

.tool-tip--image {
  overflow: hidden;
  border-radius: 1em;
  width: 4.3em;
}

.tool-tip--text {
  padding: 0.6em 0.5em 0.5em 0.5em;
}

.social_icon {
