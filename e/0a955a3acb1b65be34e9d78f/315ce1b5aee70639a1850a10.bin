        </div>
        <div :class="gridCls">
            <div class="nospace" @click="onWeaponSelect(charClass.Soldier)">
                <icon name="ico-weapon-soldier" class="weapon_img roundme_md" :cls="addSelectedCssClass(charClass.Soldier)"></icon>
