  margin: 0 auto;
  text-align: center;
  font-size: 0.8em;
  letter-spacing: 0.01em;
  min-width: var(--ss-min-width);
  bottom: 0;
}

.game-info {
  min-width: 70em;
  padding: 1em 10em;
}

.game-info .eggIcon {
  color: #FFF;
  padding-top: 0.3em;
}

.game-info a {
  color: var(--ss-black);
}

.game-info li {
