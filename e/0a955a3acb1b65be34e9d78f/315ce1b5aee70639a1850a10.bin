		},
		onItemThatIsClicked(item) {
			console.log(item);
			extern.clickedWebFeedItem(item);
			BAWK.play('ui_click');
		},
	},
	computed: {
		activeItems() {
			return this.items.filter(item => item.active);
		}
	}
};
