  <div id="webgl-content" style="width: 800px; height: 600px">
    <div id="gameContainer" style="width: 800px; height: 600px"></div>
  </div>
  <div id="box"></div>
  <div id="loadingBox">
    <div id="spinner"></div>
    <div id="bgBar"></div>
    <div id="progressBar"></div>
  </div>
   <div id="icon"></div> 
  <p id="loadingInfo"></p>


