#unity-logo { width: 154px; height: 130px; background: url("data:image/png;base64,") no-repeat center }
#unity-progress-bar-empty { margin-left: auto; margin-right: auto; width: 141px; height: 18px; margin-top: 10px; background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAI0AAAASAQAAAABOFWCeAAAAAnRSTlMAAHaTzTgAAAAZSURBVHgBY/iPDn5gEzrAgAYkRqgQceEFAAzIU22a66fQAAAAAElFTkSuQmCC") no-repeat center }
