  if (!gameInstance.Module)1
    return;1
  if (!gameInstance.logo) {1
    gameInstance.logo = document.createElement("div");1
    gameInstance.logo.className = "logo " + gameInstance.Module.splashScreenStyle;1
    gameInstance.container.appendChild(gameInstance.logo);1
  }1
  if (!gameInstance.progress) {    1
    gameInstance.progress = document.createElement("div");1
    gameInstance.progress.className = "progress " + gameInstance.Module.splashScreenStyle;1
    gameInstance.progress.empty = document.createElement("div");1
    gameInstance.progress.empty.className = "empty";1
    gameInstance.progress.appendChild(gameInstance.progress.empty);1
    gameInstance.progress.full = document.createElement("div");1
    gameInstance.progress.full.className = "full";1
    gameInstance.progress.appendChild(gameInstance.progress.full);1
    gameInstance.container.appendChild(gameInstance.progress);1
  }1
  gameInstance.progress.full.style.width = (100 * progress) + "%";1
  gameInstance.progress.empty.style.width = (100 * (1 - progress)) + "%";1
  if (progress == 1)1
    gameInstance.logo.style.display = gameInstance.progress.style.display = "none";1
}E00000Ô»÷_SËó2»g5¡ÈA° bÅr" "älTì¨ 4ØcWl4T5D½Eåª×kÁ®Ø°KÉ9±cÇví^ì]#M0òÜÄûù¾T×ëùTü2ÉÉîÌîÌìììÎûøC§Mk6W;^_V){Ò5Ñ£91Òöî¼ºÆ7OªËÃ¾É|¤OkwDLv¡6	Xòs{öNVln)¯­Ôº°FÆêà2¸ôüOeé©9|O"SCÝÕM*ý%ùÕ¿Äâ¿6èc¯í28=°¥HÁ6cÀêNPµXªG%2ir:¦ÂWbÒÒåQHáÃúg¢d¶9ÈÈ¼»J¿PÆRW8÷óÿÐÐ6¼ô½Ð­³Z°°ßnê§}i½)FKÜbLðt¾£4d@w3$ÍvmDLwò3m#ÈKcõ¶IìÊ×·¤K3oegz»h¡ÚÑ»ö.¡Ñ¹ú`}3ÃEùáÖû5¢ÏÓ¨?I9òpª£Lr¸2JðºÕRú#6+xpuÑC5ÛkI;mPÔE¦$¸8«\&2K|~nJ	M³2äÖ¾Y´F¥nCÀHåÛ#E¤á]ªRüÚ^RÁÚ$÷û8¥¥9.K½xTØ=¼¿¤©ÏH-®üH]D²©ýKQw©ç®¢|EcbóHPCæHoâÃBÛN ;Ù8vDUÐ9H¦puæn`JuÎ#¥LX>}(½»¡N$Ï4=çQ5m¬jRhDò=a×ECPÄâ´[í(]íý·°WtÏØí5ÌÚCº¹±¥z?aÏvebµ6½å^_×5FÿñPxÃèµ¬ÒÎíqSú± .í?Ë3o[êPí9jÌ,j×Z+6lIÛR©fKªel>%L»Æ
