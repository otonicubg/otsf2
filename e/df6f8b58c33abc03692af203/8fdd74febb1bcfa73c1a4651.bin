<title>Drift City - Otonic</title><link rel="shortcut icon" href="favicon.ico"><style>.webgl-content * {border: 0; margin: 0; padding: 0}


.webgl-content .logo, .progress {position: absolute; left: 50%; top: 50%; -webkit-transform: translate(-50%, -50%); transform: translate(-50%, -50%);}
.webgl-content .logo {background: url("data:image/png;base64,") no-repeat center / contain; width: 154px; height: 130px;}
.webgl-content .progress {height: 18px; width: 141px; margin-top: 90px;}
.webgl-content .progress .empty {background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAI0AAAASCAMAAABRsK0BAAAACVBMVEUAAAAiLDb///8YyA6XAAAAAXRSTlMAQObYZgAAACxJREFUeNrt1jENAAAMw7COP+khmLSzh4PAZzJN1WnSEg0NDQ0NDc1f42/uFiHYAm2vaAqhAAAAAElFTkSuQmCC") no-repeat right / cover; float: right; width: 100%; height: 100%; display: inline-block;}
.webgl-content .progress .full {background: url("data:image/png;base64,") no-repeat left / cover; float: left; width: 0%; height: 100%; display: inline-block;}

.webgl-content .logo.Dark {background-image: url("data:image/png;base64,");}
.webgl-content .progress.Dark .empty {background-image: url("data:image/png;base64,");}
.webgl-content .progress.Dark .full {background-image: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAI0AAAASAQAAAABOFWCeAAAABGdBTUEAALGPC/xhBQAAACBjSFJNAAB6JgAAgIQAAPoAAACA6AAAdTAAAOpgAAA6mAAAF3CculE8AAAAAmJLR0QAAd2KE6QAAAABb3JOVAHPoneaAAAAEklEQVQY02P4jw5+MIwKUSoEAFGIQk7F6gAZAAAADHRFWHRkYXRlOmNyZWF0ZQBSVM8wAAAADHRFWHRkYXRlOm1vZGlmeQC8Io40AAAAAElFTkSuQmCC");}

.webgl-content .footer {margin-top: 5px; height: 38px; line-height: 38px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 18px;} 
.webgl-content .footer .webgl-logo, .title, .fullscreen {height: 100%; display: inline-block; background: transparent center no-repeat;} 
.webgl-content .footer .webgl-logo {background-image: url("data:image/png;base64,"); width: 204px; float: left;}
.webgl-content .footer .title {margin-right: 10px; float: right;}
.webgl-content .footer .fullscreen {background-image: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACYAAAAmCAMAAACf4xmcAAAAG1BMVEUertNWwd7x+vz///9JvtvV8veq3+4ss9bH6/SvnBSZAAAAVElEQVR42u3QMQ4AMQgDQQcw5P8vjmiuNdJVkbL1FJbxurxl3kkXHDFks5nyiUoqVnTfKINyyQICvytNomelhFY9noo52U9I5hOFT2nG0KyzhdfdHe3hAVoFqCBEAAAAAElFTkSuQmCC"); width: 38px; float: right;}


