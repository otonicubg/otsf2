    <title>Granny - Otonic</title>
    <link rel="icon" href="logo.jpg">
    
    
    <meta name="description" content="Granny: Enter a chilling survival horror experience! Trapped in Granny's eerie house, evade her watchful eye, solve puzzles, and find a way to escape. Stealth, strategy, and nerves of steel are your only allies in this heart-pounding game. Can you outwit Granny and survive her sinister abode?">

    <style>body {
    padding: 0;
    margin: 0
}

#unity-container {
    position: absolute
}

#unity-container.unity-desktop {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%)
}

#unity-container.unity-mobile {
    position: fixed;
    width: 100%;
    height: 100%
}

#unity-canvas {
    background: #231F20
}

.unity-mobile #unity-canvas {
    width: 100%;
    height: 100%
}

#unity-loading-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: none
}

#unity-logo {
    width: 154px;
    height: 130px;
    background: url("data:image/png;base64,") no-repeat center
}

#unity-progress-bar-empty {
    width: 141px;
    height: 18px;
    margin-top: 10px;
    margin-left: 6.5px;
    background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAI0AAAASAQAAAABOFWCeAAAAAnRSTlMAAHaTzTgAAAAZSURBVHgBY/iPDn5gEzrAgAYkRqgQceEFAAzIU22a66fQAAAAAElFTkSuQmCC") no-repeat center
}

#unity-progress-bar-full {
    width: 0%;
    height: 18px;
    margin-top: 10px;
    background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAI0AAAASAQAAAABOFWCeAAAAEUlEQVR4AWP4jw5+UCw0KgQAUYhCTnW3FD4AAAAASUVORK5CYII=") no-repeat center
}

#unity-footer {
    position: relative
}

.unity-mobile #unity-footer {
    display: none
}

#unity-webgl-logo {
    float: left;
    width: 204px;
    height: 38px;
    background: url('webgl-logo.png') no-repeat center
}

#unity-build-title {
    float: right;
    margin-right: 10px;
    line-height: 38px;
    font-family: arial;
    font-size: 18px
}

#unity-fullscreen-button {
    cursor: pointer;
    float: right;
