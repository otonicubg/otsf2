<body style="overflow:hidden;">
<div id="loader">
<div id="slideshow">
<div id="slideshow-top">
<img alt="War of Caribbean Pirates" id="thumbnail" title="War of Caribbean Pirates" data-w2s-src="/thumbnail.jpg">
<div id="slideshow-top-container">
<div id="game-title">
<h1>War of Caribbean Pirates</h1>
</div>
<div id="progress-container">
<div id="progress-bar">
<div id="progress-fill" style="width:0%"></div>
</div>
<div id="progress-amount">0%</div>
</div>
</div>
</div>
<div id="slideshow-images"></div>
<div id="slideshow-nav"></div>
</div>
</div>
<div id="game-container">
<div id="game"></div>
</div>
<script>__W2S__.inline("/scripts/poki-unity-loader.js",{"type":"text/javascript"})</script>
