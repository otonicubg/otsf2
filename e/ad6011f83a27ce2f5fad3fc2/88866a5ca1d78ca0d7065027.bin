                    <button class="button switch" type="button" onclick="nitroclash.switchSide();" title="Leave team" lang="en">Switch side</button>
                    <div class="private-block"><input id="private-game" type="checkbox"><label for="private-game">Private game</label></div>
                    <div id="team-chat-block">
                        <div>
                            Chat: <input id="team-chat-input" type="text" maxlength="64" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
                        </div>
                        <div id="team-chat-history">I scored!!!
