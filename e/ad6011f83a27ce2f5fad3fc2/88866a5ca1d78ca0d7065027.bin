            border-radius: 4px;
            margin-left: auto;
            margin-right: auto;
            margin-bottom: 16px
        }

        @media screen and (max-height:400px) {
            #homepage .content .middle-box #username {
                font-size: 20px;
                height: 40px;
                margin-bottom: 8px
            }
        }

        #homepage .content .middle-box .button {
            display: block;
            width: 100%;
            height: 64px;
            font-size: 32px;
            border-radius: 16px;
            margin-top: 32px;
            max-width: 250px;
            height: 48px;
            font-size: 20px;
            border-radius: 4px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .2), 0 4px 0 #1678c2;
            margin-left: auto;
            margin-right: auto;
            margin-top: 16px
        }

        @media screen and (max-height:400px) {
            #homepage .content .middle-box .button {
                font-size: 20px;
                height: 40px
            }
        }

        #homepage .content .middle-box .secondary-buttons .button,
        #homepage .content .middle-box .skin-buttons .button {
            display: inline-block;
            box-sizing: border-box;
            width: 50%;
            max-width: 120px;
            font-size: 14px;
            height: 24px;
            padding-top: 4px;
            padding-bottom: 4px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .2), 0 4px 0 #95a5a6
        }

        #homepage .content .middle-box .secondary-buttons .button:hover,
        #homepage .content .middle-box .skin-buttons .button:hover {
            box-shadow: 0 2px 10px rgba(0, 0, 0, .2), 0 4px 0 #798d8f
        }

        #homepage .content .middle-box .secondary-buttons #blue-skin-input,
        #homepage .content .middle-box .secondary-buttons #red-skin-input,
        #homepage .content .middle-box .secondary-buttons #replay-file-input,
        #homepage .content .middle-box .skin-buttons #blue-skin-input,
        #homepage .content .middle-box .skin-buttons #red-skin-input,
        #homepage .content .middle-box .skin-buttons #replay-file-input {
            display: none
        }

        #homepage .content .middle-box #skin-editor {
