        }

        @keyframes slideOutUp {
            0% {
                -webkit-transform: translateZ(0);
                transform: translateZ(0)
            }

            to {
                -webkit-transform: translate3d(0, -100%, 0);
                transform: translate3d(0, -100%, 0);
                visibility: hidden
            }
        }

        .slideOutUp {
            -webkit-animation-name: slideOutUp;
            animation-name: slideOutUp
        }

        .animated {
            -webkit-animation-duration: 1s;
            -webkit-animation-fill-mode: both;
            animation-duration: 1s;
            animation-fill-mode: both
        }

        .animated.infinite {
            -webkit-animation-iteration-count: infinite;
            animation-iteration-count: infinite
        }

        .animated.delay-1s {
            -webkit-animation-delay: 1s;
            animation-delay: 1s
        }

        .animated.delay-2s {
            -webkit-animation-delay: 2s;
            animation-delay: 2s
        }

        .animated.delay-3s {
            -webkit-animation-delay: 3s;
            animation-delay: 3s
        }

        .animated.delay-4s {
            -webkit-animation-delay: 4s;
            animation-delay: 4s
        }

        .animated.delay-5s {
            -webkit-animation-delay: 5s;
            animation-delay: 5s
        }

        .animated.fast {
            -webkit-animation-duration: .8s;
            animation-duration: .8s
        }

        .animated.faster {
            -webkit-animation-duration: .5s;
            animation-duration: .5s
        }

        .animated.slow {
            -webkit-animation-duration: 2s;
            animation-duration: 2s
        }

        .animated.slower {
            -webkit-animation-duration: 3s;
            animation-duration: 3s
        }

        @media (prefers-reduced-motion) {
            .animated {
                -webkit-animation: unset !important;
                -webkit-transition: none !important;
                animation: unset !important;
                transition: none !important
            }
        }

        @font-face {
            font-family: ActionMan-Bold;
            src: url(fonts/ActionMan-Bold.eot);
            src: url(fonts/ActionMan-Bold.eot?#iefix) format('embedded-opentype'), url("data:font/woff;base64,") format('woff'), url(fonts/ActionMan-Bold.ttf) format('truetype');
            font-weight: 400;
            font-style: normal
        }

        @font-face {
            font-family: Cartwheel;
            src: url(fonts/Cartwheel_2.eot);
            src: url(fonts/Cartwheel_2.eot?#iefix) format('embedded-opentype'), url("data:font/woff;base64,") format('woff'), url(fonts/Cartwheel_2.ttf) format('truetype');
            font-weight: 400;
            font-style: normal
        }

        @font-face {
            font-family: 'Exo 2';
            src: url(fonts/Exo2-Bold.eot);
            src: url(fonts/Exo2-Bold.eot?#iefix) format('embedded-opentype'), url(fonts/Exo2-Bold.woff) format('woff'), url(fonts/Exo2-Bold.ttf) format('truetype');
            font-weight: 700;
            font-style: normal
        }

        @font-face {
            font-family: 'Exo 2 Extra';
            src: url(fonts/Exo2-ExtraBold.eot);
            src: url(fonts/Exo2-ExtraBold.eot?#iefix) format('embedded-opentype'), url(fonts/Exo2-ExtraBold.woff) format('woff'), url(fonts/Exo2-ExtraBold.ttf) format('truetype');
            font-weight: 800;
            font-style: normal
        }

        .tossing {
            animation-name: tossing;
            -webkit-animation-name: tossing;
            animation-duration: 5s;
            -webkit-animation-duration: 5s;
            animation-iteration-count: infinite;
            -webkit-animation-iteration-count: infinite
        }

        @keyframes tossing {
            0% {
                transform: rotate(-2deg)
            }

            50% {
                transform: rotate(2deg)
            }

            100% {
                transform: rotate(-2deg)
            }
        }

        @-webkit-keyframes tossing {
            0% {
                -webkit-transform: rotate(-2deg)
            }

            50% {
                -webkit-transform: rotate(2deg)
            }

            100% {
                -webkit-transform: rotate(-2deg)
            }
        }

        @keyframes hover {
            20% {
                transform: translate3d(-3px, 0, 0)
            }

            40% {
                transform: translate3d(3px, 0, 0)
            }

            60% {
                transform: translate3d(-3px, 0, 0)
            }

            80% {
                transform: translate3d(3px, 0, 0)
            }
        }

        @keyframes tossing2 {
            0% {
                transform: rotate(0)
            }

            50% {
                transform: rotate(3deg)
            }

            75% {
                transform: rotate(-2deg)
            }

            100% {
                transform: rotate(0)
            }
        }

        @keyframes rotate {
            0% {
                transform: rotate(0)
            }

            50% {
                transform: rotate(180deg)
            }

            100% {
                transform: rotate(360deg)
            }
        }

        @-webkit-keyframes tada2 {
            0% {
                -webkit-transform: scaleX(1);
                transform: scaleX(1)
            }

            10%,
            20% {
                -webkit-transform: scale3d(.9, .9, .9) rotate(-3deg);
                transform: scale3d(.9, .9, .9) rotate(-3deg)
            }

            30%,
            50%,
            70%,
            90% {
                -webkit-transform: scale3d(1.1, 1.1, 1.1) rotate(3deg);
                transform: scale3d(1.1, 1.1, 1.1) rotate(3deg)
            }

            40%,
            60%,
            80% {
                -webkit-transform: scale3d(1.1, 1.1, 1.1) rotate(-3deg);
                transform: scale3d(1.1, 1.1, 1.1) rotate(-3deg)
            }

            to {
                -webkit-transform: scaleX(1);
                transform: scaleX(1)
            }
        }

        @keyframes tada2 {
            0% {
                -webkit-transform: scaleX(1);
                transform: scaleX(1)
            }

            10%,
            20% {
                -webkit-transform: scale3d(.7, .7, .7) rotate(-3deg);
                transform: scale3d(.7, .7, .7) rotate(-3deg)
            }

            30%,
            50%,
            70%,
            90% {
                -webkit-transform: scale3d(1.3, 1.3, 1.3) rotate(3deg);
                transform: scale3d(1.3, 1.3, 1.3) rotate(3deg)
            }

            40%,
            60%,
            80% {
                -webkit-transform: scale3d(1.3, 1.3, 1.3) rotate(-3deg);
                transform: scale3d(1.3, 1.3, 1.3) rotate(-3deg)
            }

            to {
                -webkit-transform: scaleX(1);
                transform: scaleX(1)
            }
        }

        .tada2 {
            -webkit-animation-name: tada2;
            animation-name: tada2
        }

        body,
        html {
            height: 100%;
            font-family: Arial
        }

        body {
            padding: 0;
            margin: 0
        }

        .blurred {
            filter: blur(15px);
            pointer-events: none
        }

        #fadeScreen {
            pointer-events: none;
            user-select: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #000;
            display: none;
            z-index: 50
        }

        #inGameScore {
            pointer-events: none;
            user-select: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            text-align: center;
            z-index: 1;
            color: #fff;
            font-weight: 700;
            font-size: 36px;
            border-width: 4px;
            margin-top: 8px;
            display: none;
            font-family: Cartwheel, 'Exo 2 Extra';
            text-transform: uppercase
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #inGameScore {
                font-size: 16px;
                font-size: 3.2vh
            }
        }

        #inGameScore .blue {
            display: inline-block;
            background-color: #3b4f8f;
            border: 4px solid #132561;
            border-radius: 12px;
            padding: 0 8px;
            width: 40px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #inGameScore .blue {
                border: 2px solid #132561;
                border: .4vh solid #132561;
                width: 20px;
                border-radius: 6px;
                width: 4vh;
                border-radius: 1.2vh
            }
        }

        #inGameScore .time {
            display: inline-block;
            background-color: #fff;
            border: 4px solid #000;
            color: #000;
            padding: 0 8px;
            margin-left: 2px;
            margin-right: 2px;
            width: 80px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #inGameScore .time {
                border: 2px solid #000;
                border: .4vh solid #000;
                width: 40px;
                width: 8vh
            }
        }

        #inGameScore .red {
            display: inline-block;
            background-color: #d37647;
            border: 4px solid #8f390d;
            border-radius: 12px;
            padding: 0 8px;
            width: 40px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #inGameScore .red {
                border: 2px solid #8f390d;
                border: .4vh solid #8f390d;
                width: 20px;
                border-radius: 6px;
                width: 4vh;
                border-radius: 1.2vh
            }
        }

        #inGameScore .blue,
        #inGameScore .red,
        #inGameScore .time {
            vertical-align: middle;
            padding-bottom: 6px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {

            #inGameScore .blue,
            #inGameScore .red,
            #inGameScore .time {
                padding-bottom: 3px;
                padding-bottom: .6vh
            }
        }

        @keyframes blinker {
            50% {
                opacity: 0
            }
        }

        #replay {
            user-select: none;
            color: #000;
            text-align: center;
            display: none
        }

        #replay .text {
            pointer-events: none;
            position: absolute;
            top: 16px;
            right: 16px;
            z-index: 3
        }

        #replay .title {
            font-size: 4vh;
            animation: blinker 1s linear infinite
        }

        #replay .bottom-line {
            font-size: 1.5vh;
            line-height: 1.5vh
        }

        #replay .bottom-line .subtitle {
            display: inline-block
        }

        #replay .bottom-line .skip-count {
            margin-left: 8px;
            float: right
        }

        #replay .button.back {
            position: absolute;
            left: 8px;
            bottom: 8px;
            z-index: 3
        }

        #quickchat {
            pointer-events: none;
            user-select: none;
            position: absolute;
            top: 70px;
            left: 0;
            width: 100%;
            text-align: center;
            z-index: 2;
            color: #000;
            font-size: 14px;
            display: none
        }

        #quickchat div {
            display: inline-block;
            margin: 0 4px
        }

        #control-in {
            overflow: hidden;
            pointer-events: none;
            user-select: none;
            position: absolute;
            top: 15%;
            left: 0;
            width: 100%;
            text-align: center;
            z-index: 2;
            font-size: 32px;
            font-weight: 700;
            color: #222;
            display: none;
            font-family: Cartwheel, 'Exo 2 Extra';
            letter-spacing: 2px;
            text-transform: uppercase
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #control-in {
                font-size: 16px;
                font-size: 1.6vh
            }
        }

        #countdown {
            overflow: hidden;
            pointer-events: none;
            user-select: none;
            position: absolute;
            top: 25%;
            left: 0;
            width: 100%;
            text-align: center;
            z-index: 2;
            font-size: 64px;
            font-weight: 700;
            color: #222;
            display: none;
            font-family: Cartwheel, 'Exo 2 Extra';
            letter-spacing: 4px;
            text-transform: uppercase
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #countdown {
                font-size: 32px;
                font-size: 6.4vh
            }
        }

        #goal {
            overflow: hidden;
            pointer-events: none;
            user-select: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            text-align: center;
            z-index: 2;
            color: #222;
            display: none
        }

        #goal .top {
            position: absolute;
            width: 50%;
            top: 30%;
            left: 25%;
            transform: translate(-50%, 0);
            font-size: 96px;
            font-weight: 700;
            font-family: Cartwheel, 'Exo 2 Extra';
            text-transform: uppercase;
            letter-spacing: 4px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #goal .top {
                font-size: 48px;
                font-size: 9.6vh;
                top: 20%
            }
        }

        #goal .bottom {
            position: absolute;
            bottom: 20%;
            width: 100%;
            color: #fff
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #goal .bottom {
                bottom: 10%
            }
        }

        #goal .bottom .box {
            background-color: rgba(0, 0, 0, .6);
            margin: 0 auto;
            display: inline-block;
            padding: 16px;
            border-radius: 16px;
            width: auto;
            font-family: ActionMan-Bold, 'Exo 2';
            font-weight: 700;
            text-transform: uppercase
        }

        #goal .bottom .box .player-name {
            font-weight: 400;
            text-transform: none
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #goal .bottom .box {
                padding: 12px;
                padding: 2.4vh
            }
        }

        #goal .bottom .table {
            display: table;
            width: auto
        }

        #goal .bottom .row {
            display: table-row;
            vertical-align: middle
        }

        #goal .bottom .field,
        #goal .bottom .field2 {
            text-align: left;
            font-size: 32px;
            font-weight: 700;
            font-family: ActionMan-Bold, 'Exo 2';
            font-weight: 700;
            text-transform: uppercase;
            vertical-align: middle;
            display: table-cell;
            padding-bottom: 16px;
            text-align: right
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {

            #goal .bottom .field,
            #goal .bottom .field2 {
                font-size: 16px;
                font-size: 3.2vh;
                padding-bottom: 8px;
                padding-bottom: 1.6vh
            }
        }

        #goal .bottom .field2 {
            font-size: 24px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #goal .bottom .field2 {
                font-size: 12px;
                font-size: 2.4vh
            }
        }

        #goal .bottom .value {
            padding-left: 32px;
            font-weight: 700;
            font-size: 24px;
            vertical-align: middle;
            display: table-cell;
            text-align: right;
            padding-bottom: 16px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #goal .bottom .value {
                font-size: 12px;
                font-size: 2.4vh;
                padding-bottom: 8px;
                padding-bottom: 1.6vh
            }
        }

        #goal #goalscorer-name {
            padding-bottom: 6px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #goal #goalscorer-name {
                padding-bottom: 3px;
                padding-bottom: .6vh
            }
        }

        #goal #assist-name {
            padding-bottom: 12px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #goal #assist-name {
                padding-bottom: 6px;
                padding-bottom: 1.2vh
            }
        }

        .player-name {
            font-family: Arial;
            font-weight: 400;
            text-transform: none;
            display: inline-block;
            overflow: hidden;
            max-width: 200px
        }

        #nitro-bar {
            display: none;
            pointer-events: none;
            user-select: none;
            position: absolute;
            bottom: 16px;
            left: 0;
            width: 100%;
            height: 32px;
            text-align: center;
            z-index: 3;
            box-sizing: border-box
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #nitro-bar {
                bottom: 4px;
                height: 24px;
                font-size: 14px;
                bottom: .8vh;
                height: 4.8vh;
                font-size: 2.8vh
            }
        }

        #nitro-bar .box {
            width: 25%;
            height: 100%;
            left: 37.5%;
            position: absolute;
            vertical-align: middle
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #nitro-bar .box {
                width: 50%;
                left: 25%
            }
        }

        #nitro-bar .box .text {
            position: absolute;
            right: 16px;
            height: 100%;
            line-height: 32px;
            text-align: right;
            vertical-align: middle;
            color: #a80;
            font-family: ActionMan-Bold, 'Exo 2';
            font-weight: 700;
            text-transform: uppercase
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #nitro-bar .box .text {
                line-height: 24px;
                line-height: 4.8vh
            }
        }

        #nitro-bar .box .borders {
            border: 4px solid #a80;
            border-radius: 8px;
            width: 100%;
            height: 100%;
            position: absolute;
            top: -4px;
            left: -4px
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #nitro-bar .box .borders {
                border: 2px solid #a80;
                border-radius: 4px;
                top: -2px;
                left: -2px;
                border: .4vh solid #a80;
                border-radius: .8vh;
                top: -.4vh;
                left: -.4vh
            }
        }

        #nitro-bar .box .bar {
            background-color: #fd5;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 25%
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #nitro-bar .box .bar {
                border-top-right-radius: 4px;
                border-bottom-right-radius: 4px;
                border-top-right-radius: .8vh;
                border-bottom-right-radius: .8vh
            }
        }

        #game-over,
        #sudden-death {
            overflow: hidden;
            pointer-events: none;
            user-select: none;
            position: absolute;
            width: 100%;
            height: 100%;
            text-align: center;
            z-index: 2;
            left: 0;
            top: 0;
            font-size: 64px;
            font-weight: 700;
            font-family: Cartwheel, 'Exo 2 Extra';
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 4px;
            display: none
        }

        @media screen and (max-width:600px),
        screen and (max-height:768px) {

            #game-over,
            #sudden-death {
                font-size: 32px;
                font-size: 6.4vh
            }
        }

        #game-over .text,
        #sudden-death .text {
            position: absolute;
            width: 50%;
            top: 20%;
            left: 25%;
            transform: translate(-50%, 0);
            display: inline-block
        }

        .leaderboard-block {
            display: none;
            overflow: hidden;
            pointer-events: none;
            user-select: none;
            position: absolute;
            text-align: left;
            bottom: 16px;
            right: 16px;
            font-family: Arial;
            border-radius: 12px;
            padding: 8px 16px;
            z-index: 45;
            background-color: rgba(0, 0, 0, .5);
            color: #fff
        }

        .leaderboard-block .title {
            text-align: center
        }

        .leaderboard-block .subtitle {
            text-align: center;
            margin-bottom: 8px;
            font-size: 12px
        }

        .leaderboard-block .lb-item .points {
            float: right;
            margin-left: 8px
        }

        .leaderboard-block .lb-item span {
            vertical-align: middle
        }

        .leaderboard-block .is-self {
            color: #888
        }

        .leaderboard-block .separator {
            border-bottom: 1px solid #8e8e8e;
            margin: 8px 0
        }

        .leaderboard-block .footer {
            text-align: right;
            font-size: 10px;
            margin-top: 4px
        }

        #player-action {
            display: none;
            pointer-events: none;
            user-select: none;
            position: absolute;
            width: 100%;
            height: 50%;
            text-align: center;
            z-index: 2;
            left: 0;
            top: 25%;
            font-size: 32px;
            font-weight: 700;
            font-family: Cartwheel, 'Exo 2 Extra';
            font-weight: 700;
            text-transform: uppercase
        }

        #player-action #player-action-text {
            height: 20%;
            animation-duration: 2s
        }

        @media screen and (max-width:600px),
        screen and (max-height:767px) {
            #player-action {
                font-size: 16px;
                font-size: 3.2vh
            }
        }

        #level-progress {
            display: none;
            position: absolute;
            top: 16px;
            right: 16px;
            z-index: 45;
            text-align: center;
            font-family: ActionMan-Bold, 'Exo 2';
            font-weight: 700;
            text-transform: uppercase;
            font-size: 20px;
            color: #fff;
            border-radius: 16px;
            padding: 16px;
            padding-top: 24px;
            background-color: rgba(0, 0, 0, .5);
            box-shadow: 4px 4px 10px 0 rgba(0, 0, 0, .5)
        }

        #level-progress .close {
            position: absolute;
            right: 12px;
            top: 12px;
            cursor: pointer;
            font-size: 0
        }

        #level-progress .close img {
            width: 12px;
            height: 12px;
            color: #fff
        }

        #level-progress .text {
            margin-bottom: 8px
        }

        #level-progress .rank {
            font-size: 16px;
            color: #d3d3d3
        }

        #level-progress .box {
            border: 2px solid #3a3a3a;
            width: 100%;
            min-width: 200px;
            height: 25px;
            border-radius: 8px
        }

        #level-progress .box .bar {
            background-color: #38e24b;
            background: linear-gradient(to bottom, #38e24b, #2ba739);
            width: 60%;
            height: 100%;
            border-radius: 5px
        }

        #achievements {
            display: none;
            position: absolute;
            top: 160px;
            right: 16px;
            z-index: 45;
            border-radius: 16px;
            padding: 16px;
            padding-top: 24px;
            background-color: rgba(0, 0, 0, .5);
            box-shadow: 4px 4px 10px 0 rgba(0, 0, 0, .5);
            text-align: center;
            font-family: ActionMan-Bold, 'Exo 2';
            font-weight: 700;
            text-transform: uppercase;
            font-size: 20px;
            color: #fff
        }

        #achievements .close {
            position: absolute;
            right: 12px;
            top: 12px;
