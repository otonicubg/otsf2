            </div>
            <div class="bottom">
                <div class="left-block">
                    <div class="center">
                        <div>
                            <button id="button-ready" type="button" class="button ready" onclick="nitroclash.readyForNextGame()" lang="en">Click here when ready</button>
                        </div>
                        <div>
                            <button id="button-change-team" type="button" class="button grey change-team" onclick="nitroclash.changeTeam()" lang="en">Change team</button>
                        </div>
