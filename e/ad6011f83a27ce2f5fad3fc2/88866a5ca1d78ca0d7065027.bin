        }

        #game-summary .bottom .promo-banner .adblocked {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: Arial;
            font-weight: 400;
            text-transform: none;
            font-size: 32px;
            font-size: 3.2vh;
            width: 100%
        }

        #game-summary .bottom .promo-banner2 {
            width: 728px;
            height: 90px;
            background-color: #f0f8ff;
            text-align: center;
            margin: 0 auto;
            margin-top: 32px
        }

        #game-summary .bottom .button.change-team,
        #game-summary .bottom .button.download,
        #game-summary .bottom .button.ready {
            font-size: 16px;
            min-width: 30vh;
            min-width: 200px;
            margin-bottom: .8vh
        }

        #game-summary .bottom .game-countdown {
            margin-bottom: 16px;
            margin-bottom: 1.6vh;
            font-family: Arial;
            font-weight: 400;
            text-transform: none;
            margin-top: 8px;
            margin-top: .8vh
        }

        #game-summary .button.back {
            position: absolute;
            left: 16px;
            bottom: 16px;
            left: 1.6vh;
            bottom: 1.6vh;
            font-size: 2vh;
            padding: .8vh 1.6vh
        }

        .button {
            cursor: pointer;
            display: inline-block;
            outline: 0;
            text-align: center;
            padding: 8px 16px;
            border-radius: 4px;
            box-shadow: none;
            border: none;
            background-color: #2185d0;
            color: #fff;
            font-size: 20px;
            text-decoration: none
        }

        .button:hover {
            background-color: #1678c2
        }

        .button.back,
        .button.grey {
            background-color: #95a5a6
        }

        .button.back:hover,
        .button.grey:hover {
            background-color: #798d8f
        }

        #connection-lost,
        #kicked-inactivity {
            position: absolute;
            width: 100%;
            height: 100%;
            text-align: center;
            user-select: none;
            z-index: 200;
            left: 0;
            top: 0;
            background-color: rgba(0, 0, 0, .5);
            font-size: 32px;
            font-weight: 700;
            display: none
        }

        #connection-lost .popup,
        #kicked-inactivity .popup {
            display: inline-block;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #fff;
            border: 8px solid #d37647;
            border-radius: 32px;
            padding: 32px
        }

        #connection-lost .popup .content,
        #kicked-inactivity .popup .content {
            width: 100%
        }

        #connection-lost .button,
        #kicked-inactivity .button {
            margin: 0 auto;
            display: block;
            margin-top: 64px
        }

        #homepage {
            position: absolute;
            width: 100%;
            height: 100%;
            left: 0;
            top: 0;
            text-align: center;
            overflow: auto
        }

        #homepage .background {
            width: 100%;
            height: 100%;
            background-image: url("data:image/png;base64,");
            background-size: cover;
            background-position: center center
        }

        #homepage .fade {
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, .5);
            display: table;
            table-layout: fixed
        }

        #homepage .row {
            display: table-row
        }

        #homepage .logo {
            position: absolute;
            user-select: none;
            top: 10%;
            width: 90%;
