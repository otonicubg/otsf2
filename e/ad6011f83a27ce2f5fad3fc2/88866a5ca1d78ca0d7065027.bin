    <div id="my-statistics" class="animated fadeIn">
        <div class="fade-bg"></div>
        <div class="center">
            <div style="margin-bottom: 24px">
                <img class="player-avatar" data-w2s-src="/img/player-B.png">
                <div id="ms-player-name" class="player-name">HockeyAddict</div>
            </div>
            <div class="level"><span lang="en">Level: </span><span id="ms-level">4</span></div>
            <div class="bar-box">
                <div class="bar" id="ms-level-progress-value"></div>
            </div>
            <div class="rank"><span lang="en">Rank: </span><span id="ms-rank">Beginner</span></div>
            <div style="text-align: center">
                <table class="stats-table">
                    <tbody>
                        <tr>
                            <td lang="en">Play time:</td>
                            <td><span id="ms-play-time">12.6</span> hours</td>
                        </tr>
                        <tr>
                            <td lang="en">Games played:</td>
                            <td id="ms-games-played">54</td>
                        </tr>
                        <tr>
                            <td lang="en">Games won:</td>
                            <td><span id="ms-games-won">23</span> (<span id="ms-win-pct">56</span>%)</td>
                        </tr>
                        <tr>
                            <td lang="en">MVP:</td>
                            <td><span id="ms-mvp">12</span> (<span id="ms-mvp-pct">2</span>%)</td>
                        </tr>
                        <tr>
                            <td lang="en">Goals:</td>
                            <td><span id="ms-goals">233</span> (avg: <span id="ms-goal-pct">5</span>/game)</td>
                        </tr>
                        <tr>
                            <td lang="en">Assists:</td>
                            <td><span id="ms-assists">12</span> (avg: <span id="ms-assist-pct">0.6</span>/game)</td>
                        </tr>
                        <tr>
                            <td lang="en">Saves:</td>
                            <td><span id="ms-saves">6</span> (avg: <span id="ms-save-pct">0.12</span>/game)</td>
                        </tr>
                        <tr>
                            <td lang="en">Shots:</td>
                            <td><span id="ms-shots">263</span><span style="display:none">(goal/shot ratio: <span id="ms-shot-pct">23</span>%)</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="achievement-title"><span lang="en">Achievements:</span> <span id="ms-achievement-count">5</span>/50</div>
            <div id="ms-achievement-list" class="achievement-list">
                <div class="achievement" title="Make 10 shots on goal in a single game"><img data-w2s-src="/img/a/1.png">
                    <div class="title">Determined Attacker</div>
                </div>
            </div>

            <button type="button" class="button close" onclick="document.getElementById('my-statistics').style.display='none';" lang="en">Close</button>
        </div>
    </div>
    <div id="leaderboards">
        <div class="fade-bg">
            <button type="button" class="button close" onclick="document.getElementById('leaderboards').style.display='none';" lang="en">Close</button>
            <div class="center">
                <div class="title">Leaderboards</div>
                <div id="leaderboards-metric-buttons" class="buttons">
                    <button type="button" class="button">Total Points</button>
                </div>
