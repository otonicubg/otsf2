                                    <div id="gamemode-3" title="1 player per team" onclick="nitroclash.selectMode(3);">1
                                        vs 1</div>
                                    <div id="gamemode-2" title="2 players per team" onclick="nitroclash.selectMode(2);">
                                        2 vs 2</div>
                                    <div id="gamemode-1" title="3 players per team" class="selected" onclick="nitroclash.selectMode(1);">3 vs 3</div>
                                    <div id="gamemode-4" title="5 players per team" onclick="nitroclash.selectMode(4);">
                                        5 vs 5</div>
                                    <br>
                                    <div id="gamemode-0" style="font-size: 14px; height: 32px; line-height: 32px;" title="Old mode with more inertia" onclick="nitroclash.selectMode(0);">Classic
                                    </div>
                                    <div id="gamemode-5" style="font-size: 14px; height: 32px; line-height: 32px;" title="Train alone on the pitch" onclick="nitroclash.selectMode(5);">Train</div>
                                </div>
                                <button id="play-button" type="button" class="button" onclick="nitroclash.clickPlay();" lang="en">Play</button>
                                <div class="secondary-buttons">
                                    <button id="spectate-button" type="button" class="button back" onclick="nitroclash.clickSpectate();" lang="en">Spectate</button>
                                    <label class="button back" for="replay-file-input">Watch replay</label>
                                    <input id="replay-file-input" type="file" accept=".ncr">
                                </div>
                                <div id="skin-editor">
                                    <div id="skin-buttons" class="skin-buttons"> <label class="button back" for="blue-skin-input">Load blue skin</label><input id="blue-skin-input" type="file" accept="image/*"><label class="button back" for="red-skin-input">Load red skin</label><input id="red-skin-input" type="file" accept="image/*"></div>
                                    <div class="game-sprites"><select id="skin-editor-game-sprites"></select><label class="button" for="skin-editor-input2">Replace game sprite</label><input id="skin-editor-input2" type="file" accept="image/*">
                                    </div>
                                </div>

                                <div id="server-block" class="server">
                                    <span class="label" lang="en">Server</span>
                                    <span class="field"><select name="server" id="server">
                                            <option>Loading...</option>
                                        </select>
                                    </span>
                                </div>
                                <!--
                                <div class="feedback">Help improve the game by <a href onclick="document.getElementById('doorbell-button').click();return false;">giving feedback</a></div>
-->
                                <div class="no-translation" id="no-translation">No translation for your language. <a href="http://pootle.nitroclash.io/projects/NITROCLASH/" target="_blank">Help us
                                        with translation</a></div>
                                <div class="update-translation" id="update-translation">Missing or incorrect translation
                                    ? <a href="http://pootle.nitroclash.io/projects/NITROCLASH/" target="_blank">Help us
                                        with translation</a></div>
                            </div>
                        </div>
                    </div>
                    <div class="right-box">
                        <div class="inside">
                            <div class="title" lang="en">What's new ?</div>
                            <ul>
                                <li><b>2022-11-11</b>:
                                    he Main 5v5 Tournament is here! The tournament will held this weekend! Saturday
                                    November the 12th! Tour time NY/EST 10:00 - UTC 15:00 - CET 16:00 - PKT 20:00.
                                    Anyone can play in the tournament, join a team or create a team! If you can't find a
                                    teammate then you can tell the organizers you are looking for a teammate and we will
                                    find you a teammate! (Tour will be on the Europe server) You must <a href="https://discord.gg/XPpNmhq" target="_blank" title="Chat on Discord">join
                                        the discord server</a> to sign up. Sign up deadline will be on Friday 16 UTC
                                    <div><a href="https://discord.gg/XPpNmhq" target="_blank"><img style="width: 100%; height: auto;" data-w2s-src="/img/tournament21.png"></a></div>
                                </li>
                            </ul>

                            <div class="watch-tourney">Watch: <button class="button" onclick="nitroclash.spectateTourney(3);" style="display: inline-block">1v1</button>
                                <button class="button" onclick="nitroclash.spectateTourney(2);" style="display: inline-block">2v2</button>
                                <button class="button" onclick="nitroclash.spectateTourney(1);" style="display: inline-block">3v3</button>
                                <button class="button" onclick="nitroclash.spectateTourney(4);" style="display: inline-block">5v5</button>
                                <button class="button" onclick="nitroclash.spectateTourney(0);" style="display: inline-block; padding: 4px 4px;">Classic</button>
                            </div>

                            <div class="more"><a target="_blank" href="changelog.html">more...</a></div>
                            <div class="cp"><iframe id="cp-iframe" width="267" height="120" src="https://exodragon.com/cp/?from=nitroclash"></iframe></div>
                        </div>
                    </div>
                </div>
                <div id="connecting-content" class="connecting">
                    <div class="box">
                        <div>
                            <div class="title" lang="en">How to play</div>
                        </div>
                        <div>
                            <div class="tuto-text" lang="en">
                                <span lang="en">Objective:</span>
                                <ul>
                                    <li lang="en">Push the ball into the opponent goal</li>
                                </ul>
                                <span lang="en">Controls:</span>
                                <ul id="control-mouse">
                                    <li lang="en">Use your mouse cursor to control direction</li>
                                    <li lang="en">Click mouse button to BOOST</li>
                                    <li lang="en">Hold SPACE to BRAKE / STAND STILL</li>
                                    <li><span lang="en">Press T to chat</span><span>. Press G then any 0-9 key for
                                            quickchat</span></li>
                                    <li lang="en">Press TAB to display player statistics</li>
                                </ul>
                                <ul id="control-gamepad">
                                    <li lang="en">Gamepad connected !</li>
                                    <li lang="en">Use your gamepad stick to move</li>
                                    <li lang="en">Click button 1 to BOOST</li>
                                    <li lang="en">Release stick or click button 2 to BRAKE / STAND STILL</li>
                                    <li lang="en">Press T to chat</li>
                                </ul>
                                <span lang="en">Camera:</span>
                                <ul>
                                    <li lang="en">Press C to switch between fullscreen or follow-player</li>
                                    <li lang="en">In follow-player mode, press X to switch between
                                        <ul>
                                            <li lang="en">(1) centered on player</li>
                                            <li lang="en">(2) centered on player and field</li>
                                            <li lang="en">(3) fixed zoom (use mouse wheel to zoom in/out)</li>
                                        </ul>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div id="tuto-button">
                            <div class="tuto-button">
                                <button type="button" class="button" onclick="nitroclash.clickTutoButton()" lang="en">Enter game</button>
                            </div>
                        </div>
                        <div id="connecting-message-row">
                            <div class="message"><img class="spinner" data-w2s-src="/img/ball3.png"><span id="connecting-message" lang="en">Connecting to server...</span></div>
                        </div>

                    </div>
                    <div class="asset-load">.</div>
                </div>

                <div id="settings-popup" class="settings-popup animated fadeInDown">
                    <div class="quality"><span lang="en">Graphics quality:</span>
                        <button id="button-quality-high" type="button" class="button" onclick="nitroclash.setQuality(1);" lang="en">High</button>
                        <button id="button-quality-medium" type="button" class="button unselected" onclick="nitroclash.setQuality(0.8);" lang="en">Medium</button>
                        <button id="button-quality-low" type="button" class="button unselected" onclick="nitroclash.setQuality(0.6);" lang="en">Low</button>
                        <div class="antialias"><span lang="en">Enable antialias (better quality, lower FPS):</span>
                            <input type="checkbox" id="enableAntialias" onchange="nitroclash.setEnableAntialias(document.getElementById('enableAntialias').checked);">
                        </div>
                    </div>
                    <div class="joystick mobile-only">
                        Virtual joystick follows the finger <input type="checkbox" id="settings-follow-joysticks" checked="">
                    </div>
                    <div class="gamepad"><span lang="en">Use gamepad:</span>
                        <input type="checkbox" id="useGamepad" onchange="nitroclash.setUseGamepad(document.getElementById('useGamepad').checked);">
                        <div id="gamepad-detected">Gamepad detected.</div>
                        <div id="gamepad-not-detected">Gamepad not detected (you may need to press any button)</div>
                    </div>
                    <div class="fullscreen"><span lang="en">Automatically switch fullscreen:</span>
                        <input type="checkbox" id="autoSwitchFullscreen" onchange="nitroclash.setAutoFullscreen(document.getElementById('autoSwitchFullscreen').checked);">
                    </div>
                    <div style="margin-top: 3vh">
                        <a style="color: lightgray; font-size: 0.8em" class="btn-privacy-settings" href="javascript:void(0)" onclick="if (typeof aipAPItag === 'undefined') alert('Disable your adblock'); else aipAPItag.showCMPScreen()">Privacy
                            settings</a>
                    </div>
                    <button type="button" class="button close" onclick="document.getElementById('settings-popup').style.display='none';" lang="en">Close</button>
                </div>

                <div id="login-popup" class="login-popup animated fadeInDown">
                    <table>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="title">Google</div>
                                    <div class="g-signin2" data-onsuccess="onGoogleSignIn" data-longtitle="true" data-theme="dark" data-scope="email"></div>
                                </td>
                                <td>
                                    <div class="title">Facebook</div>
                                    <div id="fb-login-button" class="fb-login-button" data-max-rows="1" data-size="large" data-button-type="login_with" data-show-faces="false" data-auto-logout-link="true" data-use-continue-as="true" data-scope="email" onlogin="onFacebookLogin();"></div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <button type="button" class="button close" onclick="document.getElementById('login-popup').style.display='none';" lang="en">Close</button>
                </div>

            </div>
        </div>
    </div>
    <div id="toasts"></div>

    <!-- DOORBELL -->
    <script>__W2S__.inline("/_w2s/inline-1.js",{"type":"text/javascript"})</script>






    <div id="preroll"></div>


</body></html>