        #game-summary {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            text-align: center;
            z-index: 40;
            font-family: ActionMan-Bold, 'Exo 2';
            font-weight: 700;
            text-transform: uppercase;
            color: #000;
        }

        #game-summary .fade-bg {
            position: absolute;
            width: 100%;
            height: 100%;
            background-color: #fff;
            opacity: .7
        }

        #game-summary .result {
            overflow: hidden;
            color: #000;
            margin-top: 16px;
            margin-bottom: 16px;
            margin-top: 1.6vh;
            margin-bottom: 1.6vh;
            width: 100%;
            font-size: 80px;
            font-size: 8vh;
            vertical-align: middle
        }

        #game-summary .result img {
            width: 64px;
            width: 6.4vh;
            vertical-align: middle
        }

        #game-summary .mvp-block {
            overflow: hidden;
            animation-delay: 2s;
            color: #000;
            vertical-align: middle;
            margin: 0 0;
            text-align: center;
            display: table;
            table-layout: fixed;
            width: 100%
        }

        #game-summary .mvp-block .mvp {
            font-size: 24px;
            font-size: 2.4vh;
            padding-left: 32px;
            display: table-cell;
            vertical-align: middle
        }

        #game-summary .mvp-block .player-name {
            font-size: 48px;
            font-size: 4.8vh;
            vertical-align: middle;
            text-transform: none;
            font-weight: 400;
            max-width: none;
            white-space: nowrap
        }

        #game-summary .mvp-block .player-block {
            animation-delay: 4s;
            display: inline-block;
            display: table-cell;
            padding-left: 16px;
            padding-right: 16px;
            overflow: hidden;
            overflow-wrap: break-word;
            vertical-align: middle;
            word-break: break-all
        }

        #game-summary .mvp-block img {
            vertical-align: middle;
            width: 48px;
            width: 4.8vh;
            margin: 0 8px
        }

        #game-summary .mvp-block .points {
            font-size: 32px;
            font-size: 3.2vh;
            display: table-cell;
            vertical-align: middle;
            padding-right: 32px
        }

        #game-summary .remaining {
            animation-delay: 6s
        }

        #game-summary .global-table {
            display: table;
            width: 100%;
            margin-top: 16px;
            margin-bottom: 16px;
            margin-top: 1.6vh;
            margin-bottom: 1.6vh
        }

        #game-summary .global-table .global-row {
            display: table-row
        }

        #game-summary .global-table .global-row .row-blue,
        #game-summary .global-table .global-row .row-red {
            color: #fff;
            display: table-cell;
            position: relative;
            width: 50%;
            padding: 16px 16px;
            padding: 1.6vh 1.6vh;
            vertical-align: middle
        }

        #game-summary .global-table .global-row .row-blue .team-name,
        #game-summary .global-table .global-row .row-red .team-name {
            display: inline-block;
            font-size: 20px;
            font-size: 2vh;
            padding-left: 8px;
            padding-left: .8vh;
        }

        #game-summary .global-table .global-row .row-blue .score,
        #game-summary .global-table .global-row .row-red .score {
            display: inline-block;
            text-align: right;
            font-size: 20px;
            font-size: 2vh;
            padding-right: 8px;
            padding-right: .8vh;
            padding-bottom: 8px;
            padding-bottom: .8vh
        }

        #game-summary .global-table .global-row .blue-box {
            background-color: #3b4f8f;
            border: 4px solid #132561;
            border: .4vh solid #132561;
            border-radius: 12px;
            border-radius: 1.2vh;
            padding: 16px 16px;
            padding: 1.6vh 1.6vh;
            padding-top: 20px;
            padding-top: 2vh;
            box-shadow: 4px 4px 10px 0 rgba(0, 0, 0, .5);
            box-shadow: .4vh .4vh 1vh 0 rgba(0, 0, 0, .5)
        }

        #game-summary .global-table .global-row .red-box {
            background-color: #d37647;
            border: 4px solid #8f390d;
            border: .4vh solid #8f390d;
            border-radius: 12px;
            border-radius: 1.2vh;
            padding: 16px 16px;
            padding: 1.6vh 1.6vh;
            padding-top: 20px;
            padding-top: 2vh;
            box-shadow: 4px 4px 10px 0 rgba(0, 0, 0, .5);
            box-shadow: .4vh .4vh 1vh 0 rgba(0, 0, 0, .5)
        }

        #game-summary .global-table .global-row .score-table {
            display: table;
            margin: auto auto;
            width: 100%;
            font-size: 14px;
            font-size: 1.4vh;
            border-collapse: collapse
        }

        #game-summary .global-table .global-row .score-table .header-row,
        #game-summary .global-table .global-row .score-table .row {
            display: table-row
        }

        #game-summary .global-table .global-row .score-table .header-row .header,
        #game-summary .global-table .global-row .score-table .header-row .row-cell,
        #game-summary .global-table .global-row .score-table .row .header,
        #game-summary .global-table .global-row .score-table .row .row-cell {
            display: table-cell;
            padding: 2px
        }

        #game-summary .global-table .global-row .score-table .header-row {
            font-size: 14px;
            font-size: 1.4vh;
            font-weight: 700
        }

        #game-summary .global-table .global-row .score-table .row-cell {
            border: 1px solid #ccc;
            width: 20%;
            vertical-align: middle
        }

        #game-summary .global-table .global-row .score-table .row div:first-child {
            border: none;
            width: 36px;
            width: 3.6vh;
            visibility: hidden
        }

        #game-summary .global-table .global-row .score-table .row img {
            width: 28px;
            width: 2.8vh;
            vertical-align: middle
        }

        #game-summary .global-table .global-row .score-table .row.left {
            color: #888
        }

        #game-summary .global-table .global-row .score-table .player-name {
            text-transform: none;
            font-weight: 400
        }

        #game-summary .bottom .left-block,
        #game-summary .bottom .right-block {
            display: inline-block;
