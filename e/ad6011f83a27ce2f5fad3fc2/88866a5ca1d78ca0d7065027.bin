            #homepage .content>div {
                height: 100%
            }
        }

        #homepage .content>div .inside {
            margin: auto auto;
            position: absolute;
            top: 60%;
            left: 50%;
            transform: translate(-50%, -50%)
        }

        #homepage .content .left-box {
            min-width: 300px;
            left: 0
        }

        #homepage .content .left-box .inside {
            max-width: 300px;
            pointer-events: all
        }

        #homepage .content .left-box .left-pub {
            width: 300px;
            height: 250px;
            text-align: center
        }

        #homepage .content .left-box .left-pub .adblocked {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: Arial;
            font-size: 32px;
            width: 100%
        }

        #homepage .content .left-box .left-pub .pf-cta {
            margin-top: 24px;
            font-size: 1.5vh;
            cursor: pointer;
            display: inline-block;
            outline: 0;
            text-align: center;
            padding: 8px 16px;
            padding: .5vh 1h;
            border-radius: .5vh;
