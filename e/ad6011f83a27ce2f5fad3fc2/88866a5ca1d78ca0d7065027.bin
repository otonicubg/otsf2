<body>
    <!-- FACEBOOK SDK -->
    <div id="fb-root"></div>
    <script>
        window.fbAsyncInit = function () {
            FB.init({
                appId: '225340674655459',
                autoLogAppEvents: true,
                xfbml: true,
                version: 'v6.0'
            });
            FB.AppEvents.logPageView();
            onFacebookLogin();
        };

        (function (d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) {
                return;
            }
            js = d.createElement(s);
            js.id = id;
            js.src = "//connect.facebook.net/en_US/sdk.js";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));

    </script>

    <div id="fadeScreen"></div>
    <div id="replay-ui">
        <div id="back-button"><button type="button" class="button back" onclick="nitroclash.backToHomepage();" lang="en">Back to homepage</button></div>
        <div id="replay-controls">
            <div class="button" onclick="nitroclash.replayControl(3);">&lt;&lt;</div>
            <div class="button" onclick="nitroclash.replayControl(0);">Play/Pause</div>
            <div class="button" onclick="nitroclash.replayControl(4);">&gt;&gt;</div>
            <div class="button" onclick="nitroclash.replayControl(1);">2x Speed</div>
            <div class="button" onclick="nitroclash.replayControl(2);">Focus Next</div>
        </div>
        <div id="event-list">
            <div id="minimize-button" onclick="javascript:var el=document.getElementById('event-list'); el.style.width = ((el.style.width=='' || el.style.width=='20%') ? '30px' : '20%');">
                Hide/show &gt;&gt;</div>
            <div id="event-list-items"></div>
        </div>

    </div>
    <div id="replay">
        <div class="text">
            <div class="title">Replay</div>
            <div class="bottom-line">
                <div id="skip-replay-text" class="subtitle">Click to skip</div>
                <div id="skip-replay-count" class="skip-count">0/6</div>
            </div>
        </div>
        <button type="button" class="button back" onclick="nitroclash.backToHomepage();" lang="en">Back to
            homepage</button>
    </div>
    <div id="inGameScore">
        <span class="blue" id="scoreB">10</span><span class="time" id="gameTime">4:21</span><span class="red" id="scoreR">2</span>
    </div>
    <div id="quickchat">
        <div>[1] Nice shot!</div>
        <div>[2] Great pass!</div>
        <div>[3] Thanks</div>
        <div>[4] Wow!</div>
        <div>[5] What a play!</div>
        <div>[6] What a save!</div>
        <div>[7] That was close...</div>
        <div>[8] Sorry!</div>
        <div>[9] No problem.</div>
        <div>[0] $#&amp;@%!</div>
    </div>
    <div id="control-in" class="animated fadeIn" lang="en">You have control in...</div>
    <div id="countdown" class="animated fadeInDown">5</div>
    <div id="goal">
        <div class="top animated tada2" lang="en">Goaaaaal !</div>

        <div class="bottom">
            <div class="box animated fadeInUp">
                <div class="table">
                    <div class="row">
                        <div class="field" lang="en">Goalscorer:
                        </div>
                        <div class="value player-name" id="goalscorer-name">Player</div>
                    </div>
                    <div class="row">
                        <div class="field2" lang="en">Shot speed:
                        </div>
                        <div class="value" id="shot-speed">10 km/h</div>
                    </div>
                    <div class="row">
                        <div class="field2" lang="en">Assist:
                        </div>
                        <div class="value player-name" id="assist-name">Player</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="nitro-bar">
        <div class="box">
            <div id="nitro-bar-value" class="bar"></div>
            <div class="borders"></div>
            <div class="text" lang="en">Nitro</div>
        </div>
    </div>
    <div id="game-over">
        <div id="game-over-text" class="text animated bounceIn" lang="en">Game Over !</div>
    </div>
    <div id="sudden-death">
        <div id="sudden-death-text" class="text animated bounceIn" lang="en">Sudden death !</div>
    </div>
    <div id="player-action">
        <div id="player-action-text" class="animated fadeOutUp">GOAL +50</div>
    </div>

    <div id="camera-text">Camera mode : Fullscreen</div>
    <div id="chat-block">
        <div id="chat-history">I scored!!!
            <br> Nice goal :)
        </div>
        <div>
            <input id="chat-input" type="text" maxlength="64" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
        </div>
    </div>
    <div id="game-summary" class="animated">
        <div class="fade-bg"></div>
        <!--
        <div id="result-winner" class="result">
            <div class="animated bounceInDown"><img src="img/winner.png"><span lang="en">WINNER</span></div>
        </div>
        <div id="result-loser" class="result">
            <div class="animated bounceInDown"><img src="img/loser.png"><span lang="en">LOSER</span></div>
        </div>
-->
        <div id="result-blue" class="result">
            <div class="animated bounceInDown"><img data-w2s-src="/img/winner.png"><span lang="en">BLUE WINS</span></div>
        </div>
        <div id="result-red" class="result">
            <div class="animated bounceInDown"><img data-w2s-src="/img/winner.png"><span lang="en">RED WINS</span></div>
        </div>
        <div class="mvp-block animated bounceInDown"><span class="mvp" lang="en">Most Valuable Player</span><span class="player-block animated bounceIn"><img id="mvp-image" data-w2s-src="/img/player-B.png"><span id="mvp-name" class="player-name">SoccerAddict</span></span><span class="points"><span id="mvp-points">570</span>
                <span> </span><span lang="en">points</span></span>
        </div>
        <div class="remaining animated fadeIn">
            <div class="global-table">
                <div class="global-row">
                    <div class="row-blue">
                        <div class="blue-box">
                            <div class="team-name" lang="en">BLUE TEAM</div>
                            <div class="score" lang="en">SCORE: <span id="score-blue">5</span></div>

                            <div id="score-table-B" class="score-table">
