            border-radius: 4px
        }

        #homepage .content .middle-box #username {
            width: 100%;
            display: block;
            height: 64px;
            font-size: 32px;
            border-radius: 16px;
            box-sizing: border-box;
            max-width: 250px;
            height: 48px;
