    <div id="level-progress" class="animated fadeInDown">
        <div class="close"><img onclick="Javascript: document.getElementById('level-progress').style.display='none';" data-w2s-src="/img/close.svg"></div>
        <div class="text"><span lang="en">Level: </span><span id="current-level">4</span></div>
        <div class="box">
            <div class="bar" id="level-progress-value"></div>
        </div>
        <div class="rank"><span lang="en">Rank: </span><span id="current-rank">Beginner</span></div>
    </div>
    <div id="achievements" class="animated fadeInUp">
        <div class="close"><img onclick="Javascript: document.getElementById('achievements').style.display='none';" data-w2s-src="/img/close.svg"></div>
        <div class="title" lang="en">Achievements</div>
        <div id="achievement-list">
            <div class="achievement">
                <img title="First Goal" data-w2s-src="/img/a/1.png">
                <div class="descr">Determined Attacker</div>
            </div>
            <div class="achievement">
                <img title="First Goal" data-w2s-src="/img/a/2.png">
                <div class="descr">Determined Attacker</div>
            </div>
        </div>
