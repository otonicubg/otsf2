                                    <div id="playerB1-ready" class="row-cell"><img class="animated fadeIn" data-w2s-src="/img/Action-ok-icon.png"></div>
                                    <div id="playerB1-name" class="row-cell player-name">Bump</div>
                                    <div id="playerB1-goals" class="row-cell">2</div>
                                    <div id="playerB1-assists" class="row-cell">1</div>
                                    <div id="playerB1-saves" class="row-cell">1</div>
                                    <div id="playerB1-points" class="row-cell">560</div>
                                </div>
                                <div id="playerB2" class="row">
                                    <div id="playerB2-ready" class="row-cell"><img class="animated fadeIn" data-w2s-src="/img/Action-ok-icon.png"></div>
                                    <div id="playerB2-name" class="row-cell player-name">Rocket</div>
                                    <div id="playerB2-goals" class="row-cell">2</div>
                                    <div id="playerB2-assists" class="row-cell">1</div>
                                    <div id="playerB2-saves" class="row-cell">1</div>
                                    <div id="playerB2-points" class="row-cell">560</div>
                                </div>
                                <div id="playerB3" class="row">
                                    <div id="playerB3-ready" class="row-cell"><img class="animated fadeIn" data-w2s-src="/img/Action-ok-icon.png"></div>
                                    <div id="playerB3-name" class="row-cell player-name">League</div>
                                    <div id="playerB3-goals" class="row-cell">2</div>
                                    <div id="playerB3-assists" class="row-cell">1</div>
                                    <div id="playerB3-saves" class="row-cell">1</div>
                                    <div id="playerB3-points" class="row-cell">560</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row-red">
                        <div class="red-box">
                            <div class="team-name" lang="en">RED TEAM</div>
                            <div class="score" lang="en">SCORE: <span id="score-red">5</span></div>

                            <div id="score-table-R" class="score-table">
                                <div class="header-row">
                                    <div class="header"></div>
                                    <div class="header"></div>
                                    <div class="header" lang="en">Goals</div>
                                    <div class="header" lang="en">Assists</div>
                                    <div class="header" lang="en">Saves</div>
                                    <div class="header" lang="en">Points</div>
                                </div>
                                <div id="playerR1" class="row">
                                    <div id="playerR1-ready" class="row-cell"><img class="animated fadeIn" data-w2s-src="/img/Action-ok-icon.png"></div>
                                    <div id="playerR1-name" class="row-cell player-name">Bumper car</div>
                                    <div id="playerR1-goals" class="row-cell">2</div>
                                    <div id="playerR1-assists" class="row-cell">1</div>
                                    <div id="playerR1-saves" class="row-cell">1</div>
                                    <div id="playerR1-points" class="row-cell">560</div>
                                </div>
                                <div id="playerR2" class="row">
                                    <div id="playerR2-ready" class="row-cell"><img class="animated fadeIn" data-w2s-src="/img/Action-ok-icon.png"></div>
                                    <div id="playerR2-name" class="row-cell player-name">Smash sport</div>
                                    <div id="playerR2-goals" class="row-cell">2</div>
                                    <div id="playerR2-assists" class="row-cell">1</div>
                                    <div id="playerR2-saves" class="row-cell">1</div>
                                    <div id="playerR2-points" class="row-cell">560</div>
                                </div>
                                <div id="playerR3" class="row">
                                    <div id="playerR3-ready" class="row-cell"><img class="animated fadeIn" data-w2s-src="/img/Action-ok-icon.png"></div>
                                    <div id="playerR3-name" class="row-cell player-name">Turbo hockey</div>
                                    <div id="playerR3-goals" class="row-cell">2</div>
                                    <div id="playerR3-assists" class="row-cell">1</div>
                                    <div id="playerR3-saves" class="row-cell">1</div>
