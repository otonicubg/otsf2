        <div id="lb-top">
            <div class="lb-item">1. <span class="player-name">IceHockey</span><span class="points">89123</span></div>
            <div class="lb-item">2. <span class="player-name">SoccerFan</span><span class="points">54362</span></div>
            <div class="lb-item is-self">3. <span class="player-name">Nitroclashio</span><span class="points">10009</span></div>
            <div class="lb-item">4. <span class="player-name">Ronaldo</span><span class="points">3232</span></div>
            <div class="lb-item">5. <span class="player-name">BigNoob</span><span class="points">5</span></div>
        </div>
        <div id="lb-player-line">
            <div class="separator"></div>
            <div class="lb-item"><span id="lb-player-rank">12</span>. <span id="lb-player-name" class="player-name">TheBest</span><span class="points" id="lb-player-points">12345</span></div>
        </div>
        <div class="footer" lang="en">Press L to show/hide</div>
    </div>
    <div id="connection-lost">
        <div class="popup">
            <div class="content" lang="en">
                Unfortunatly, the connection with the server has been lost.
                <button type="button" class="button back" onclick="nitroclash.backToHomepage();" lang="en">Back to
                    homepage</button>
            </div>
        </div>
    </div>
