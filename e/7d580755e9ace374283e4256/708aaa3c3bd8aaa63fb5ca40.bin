}

.monopoliDiv{
  display: none;
  position: absolute;
  top: 303px;
  left: 538px;
  color: #fff;
  font-size: 17px;
  font-family: monospace;
  transform: scale(.85);
  filter: blur(0.1px);
  text-shadow: 1px 1px 5px #000;
}
.monopoliSubDiv{
  padding-bottom: 5px;
}
.monopoliLevelText{

}
.monopoli_house{
  width: 23px;
  position: relative;
  top: 3px;
}
