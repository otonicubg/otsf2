  position: relative;
  left: -26px;
  text-shadow: none;
}
.monopoliDefText{
  margin-left: -9px;
}
.monopoliDefText{

}
.monopoliDef{

}

#armorVideoDiv{
  position: fixed;
  z-index: 99999;
  width: 800px;
  height: 600px;
  background: black;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
}

#armorPlayMoreGames{
  position: fixed;
  top: 582px;
  left: 100px;
  font-size: 14px;
  transform: skewX(-42deg);
  z-index: 1;
  color: #ffffff8f;
  text-shadow: 3px 1px 0px black;
}
#armorLikeUs{
  position: fixed;
  top: 582px;
  left: 624px;
  font-size: 14px;
  transform: skewX(42deg);
  z-index: 1;
  color: #ffffff8f;
  text-shadow: 3px 1px 0px black;
}
</style></head>










<body class="unselectable body" style="margin: 0px;">

  <div id="armorVideoDiv">
    <video id="armorVideo">
      <source type="video/mp4" data-w2s-src="/_remote/files.armorgames.com/648x432_v1.m4v">
      <source type="video/webm" data-w2s-src="/_remote/files.armorgames.com/648x432_v1.webm">
      <source type="video/ogg" data-w2s-src="/_remote/files.armorgames.com/648x432_v1.ogv">
    </video>
  </div>

  <a id="armorPlayMoreGames" target="_blank" href="https://armor.ag/MoreGames">Play More Games</a>
  <a id="armorLikeUs" target="_blank" href="https://www.facebook.com/ArmorGames">Like Us!</a>


  <div id="loadingDiv" class="loadingDiv">Loading...</div>

  <canvas width="800" height="600" id="backCanvas" class="toptoptop" style="cursor:none;"></canvas>
  <div id="resourcesDiv" class="resourcesDiv">
    <div class="stoneDivParent">
      <a id="stoneTitle" class="stoneTitle">STONE:</a>
      <a class="stoneNumberDiv" id="stoneNumberDiv">0</a>
    </div>
    <div class="foodDivParent">
      <a id="foodTitle" class="foodTitle">ENERGY:</a>
      <div class="foodNumberDivParent">
        <div class="foodNumberDiv" id="foodNumberDiv"></div>
        <div id="foodRealNumberDiv" class="foodRealNumberDiv">123</div>
      </div>

    </div>

    <div id="berryDivParent" class="berryDivParent">
      <a id="berryTitle">BERRIES:</a>
      <div id="berryDiv" class="berryDiv"></div>
    </div>
    <div id="gemsDivParent" class="gemsDivParent">
      <a id="gemsTitle">GEMS:</a>
      <div id="gemsDiv" class="gemsDiv"></div>
    </div>


  </div>
  <div id="tetrisStoneDiv" align="center" class="tetrisStoneDiv">
    <a id="stoneTetrisTitle">STONE</a>
    <a id="tetrisStoneNumberDiv"></a>
  </div>
  <div id="monopoliDiv" class="monopoliDiv">
    <div class="monopoliSubDiv">
      <a class="monopoliLevelText">Level </a>
      <img class="monopoli_house" data-w2s-src="/img/monopoli_house.gif">
      <a class="monopoliLevelNumberText">1</a>
      <a class="monopoliDefText">defense:</a>
      <a id="monopoliDef1" class="monopoliDef">10</a>
    </div>
    <div class="monopoliSubDiv">
      <a class="monopoliLevelText">Level </a>
      <img class="monopoli_house" data-w2s-src="/img/monopoli_house.gif">
      <a class="monopoliLevelNumberText">2</a>
      <a class="monopoliDefText">defense:</a>
      <a id="monopoliDef2" class="monopoliDef">600</a>
    </div>
    <div class="monopoliSubDiv">
      <a class="monopoliLevelText">Level </a>
      <img class="monopoli_house" data-w2s-src="/img/monopoli_house.gif">
      <a class="monopoliLevelNumberText">3</a>
      <a class="monopoliDefText">defense:</a>
      <a id="monopoliDef3" class="monopoliDef">900</a>
    </div>
  </div>


  <div id="wolfDiv" class="wolfDiv">1 wolfs remaining</div>

  <div id="playerParentDiv" class="videoClassParent">
    <div id="player" class="videoClass"></div>
    <div id="videoClassBorder" class="videoClassBorder"></div>
  </div>
  <div id="mensajesDiv" class="mensajesDiv">
    <div id="mensajeText" class="mensajeText"></div>

    <div id="corazonDiv" class="corazonDiv">
      <div class="corazonImgParent">
        <div id="corazonBarra" class="corazonBarra"></div>
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <img class="corazonImg" data-w2s-src="/img/corazon.gif">
        <div id="corazonPMDiv" class="corazonPMDiv">+</div>
      </div>
    </div>

    <div>
      <button id="mensajeButt1" class="mensajeButt"></button>
      <button id="mensajeButt2" class="mensajeButt"></button>
    </div>
  </div>

  <div id="tutorialDiv" class="tutorialDiv">
    <div align="center" class="keys tutorialDiv1">W</div>
    <div align="center" class="keys tutorialDiv1">W</div>
    <div align="center" class="keys tutorialDiv2">A</div>
    <div align="center" class="keys tutorialDiv3">S</div>
    <div align="center" class="keys tutorialDiv4">D</div>
    <div class="tutorialDivMouse"></div>
    <div class="tutorialDivMouseButt"></div>
    <div id="tutorialDivText1" class="tutorialDivText1">Move arround</div>
    <div id="tutorialDivText2" class="tutorialDivText2">Click on things</div>
    <div id="tutorialDivText3" class="tutorialDivText3">Survive 42 days.</div>
  </div>
  <div id="dayNDiv" class="dayNDiv" align="center"></div>

  <div id="winDiv" class="winDiv" align="center">
    <div id="winDiv1" class="winDiv1" align="center">The Kingdom is Safe</div>
    <div id="winDiv2" class="winDiv2" align="center">YOU WON</div>
  </div>

  <div id="tutorialDivCave" class="tutorialDivCave">
    <div class="tutorialDivMouse"></div>
    <div class="tutorialDivMouseButt"></div>
    <div id="tutorialDivCaveText" class="tutorialDivCaveText">Click to shoot</div>
  </div>



  <div id="optionsDiv" class="optionsDiv">
    <div id="optionsX" class="optionsX">&#x274c;</div>
    <div>
      <img data-w2s-src="/img/twitterAnim.gif">
      <a id="followMeA">Follow me on twitter to get notifications of my next awesome game.</a>
    </div>
    <a class="twitter-follow-button" href="https://twitter.com/AlexandriaGame" data-size="large" target="_blank" style="cursor:none">
      Follow @AlexandriaGame
    </a>

    <br><br><br>
    <a id="optionsA">Options</a>
    <br>
    <table style="width:100%">
      <tbody><tr>
        <td id="volumeA">Effects volume:</td>
        <td><input id="volumeInput" type="range" min="-25" max="10" value="0" class="slider" style="cursor:none"></td>
      </tr>
      <tr>
        <td id="blindA">Color blind:</td>
        <td><input id="colorInput" type="range" min="0" max="360" value="0" class="slider" style="cursor:none"></td>
      </tr>
      <tr>
        <td id="languageA">Language:</td>
        <td>
          <select id="idiomaInput" style="cursor:none">
            <option value="ENG" style="cursor:none">English</option>
            <option value="ES" style="cursor:none">Espa&#xf1;ol</option>
          </select>
        </td>
      </tr>
      <!-- <tr>
        <td id="showVideosA">Show videos:</td>
        <td><input id="videoInput" type="checkbox"checked  style="cursor:none"></td>
      </tr> -->
    </tbody></table>


    <br><br><br>

    <div id="thanksA"></div>
  </div>
  <img id="gearImg" class="gearImg" data-w2s-src="/img/gear.gif">

  <a id="followMeSmall" class="followMeSmall" href="https://twitter.com/AlexandriaGame" target="_blank">
    follow me on twitter
  </a>

  <a id="followMeMain" class="followMeMain" href="https://twitter.com/AlexandriaGame" target="_blank">
    <span class="followMeLink">
      @AlexandriaGame
    </span>
    <span id="followMeMainText">
      Follow me on twitter to get notifications of my next awesome game.
    </span>
  </a>

  <img id="mouseImg" class="mouseImg" data-w2s-src="/img/hand.gif">
  <canvas width="800" height="600" id="myCanvas" class="toptoptop" style="pointer-events: none;"></canvas>

  <div class="dayCircleDiv">
    <img id="dayCircleImg" class="dayCircleImg" data-w2s-src="/img/dayCircle.gif">
    <div class="dayCircleArrow">&#x2b06;</div>
  </div>



  <script>__W2S__.inline("/tone.min.js",{})</script>

  <script>
    var userLang = navigator.language || navigator.userLanguage;
    if(userLang=="es-ES" || userLang=="es"){
      document.write('\x3Cscript src="textScript_ES.js">\x3C/script>');
    }else{
      document.write('\x3Cscript src="textScript_ENG.js">\x3C/script>');
    }
    document.write('\x3Cscript src="java.js">\x3C/script>');
  </script>





  <script>
    document.getElementById("loadingDiv").style.display="none";
  </script>

</body></html>