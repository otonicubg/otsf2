            0% {
                opacity: 0;
            }
            10% {
                opacity: 0;
            }
            25% {
                opacity: 1;
            }
            80% {
                opacity: 1;
            }
            95% {
                opacity: 0;
            }
            100% {
                opacity: 0;
                display: none;
            }
