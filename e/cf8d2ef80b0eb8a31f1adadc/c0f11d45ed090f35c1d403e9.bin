            <div id="bigscore"></div>

            <div id="splash"></div>

            <div id="scoreboard">
              <div id="medal"></div>
              <div id="currentscore"></div>
              <div id="highscore"></div>
              <div id="replay">
                <img alt="replay" data-w2s-src="/assets/replay.png">
              </div>
            </div>

            <!-- Pipes go here! -->
          </div>
        </div>
        <div id="land" class="animated"><div id="debug"></div></div>
      </div>
    </div>
    <div id="footer"></div>
    <div class="boundingbox" id="playerbox"></div>
