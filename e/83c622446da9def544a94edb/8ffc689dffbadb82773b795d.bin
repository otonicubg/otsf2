<meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
<title>google feud - Otonic</title>
<meta content="classroom6x.gitlab.io" name="website">
<meta content="The world's most popular autocomplete game. Try to guess what Google will suggest. Webby Award Winner for Best Game. Created by Justin Hook." name="description">
<meta content="google games, google trivia, feud, fued, google game, google search game, autocomplete, auto complete, funny, google suggest, autocorrect, autocompete, app, let's play, @midnight, chris hardwick, pewdiepie, smosh, webbys" name="keywords">
<meta content="justin hook" name="author">
<meta content="http://www.googlefeud.com/" name="twitter:url">
<meta content="photo" name="twitter:card">
<meta content="http://www.googlefeud.com/logo.jpg" name="twitter:image">
<meta content="1200" name="twitter:image:width">
<meta content="762" name="twitter:image:height">
<meta content="Try the world's most popular autocomplete game at GoogleFeud.com." name="twitter:title">
<meta content="@justinhook" name="twitter:site">
<meta content="website" property="og:type">
<meta content="http://www.googlefeud.com/" property="og:url">
<meta content="Google Feud" property="og:title">
<meta content="The world's most popular autocomplete game. Try to guess what Google will suggest. Webby Award Winner for Best Game. Created by Justin Hook." property="og:description">
<meta content="#4385f5" name="theme-color">
<style>
      html {
        overflow-y: scroll;
      }

      h1 {
        margin: 20px 0 50px;
        display: block;
        position: relative;
      }

      #cg {
        width: 200px;
        display: block;
        margin: 0 auto 1rem;
      }

      #footerbox a,
      #footermenu a,
      #totalgames,
      a:active,
      a:link,
      a:visited {
        color: #498bf3;
      }

      #queryspan,
      #rebox,
      #wholething {
        display: inline-block;
        text-align: left;
      }

      #message,
      #wrapper {
        text-align: center;
      }

      #testdiv,
      #testdiv2,
      body,
      input[type="text"][disabled] {
        background-color: #fff;
      }

      #footermenu a,
      #queryspan,
      #rebox,
      #table1,
      #table2 {
        text-transform: lowercase;
      }

      #guess,
      .caties {
        cursor: pointer;
      }

      #___plusone_0 {
        position: relative;
        top: 2px;
      }

      #photobomber {
        margin: 40px 0;
        font-size: 15pt;
        font-weight: 700;
      }

      #footerbox a:hover,
      #gamesplayed a:link {
        text-decoration: none;
      }

      #footermenu a:hover,
      #gamesplayed a:hover {
        text-decoration: underline;
      }

      @font-face {
        font-family: "Squada One";
        font-style: normal;
        font-weight: 400;
        src: local("Squada One"), local("SquadaOne-Regular"), url("data:font/woff;base64,") format("woff");
      }

      body {
        font: 15pt Helvetica, Arial, sans-serif;
        color: #222;
      }

      #gamesplayed {
        margin: -5px 0 20px;
        font-size: 12pt;
      }

      #totalgames {
        font-weight: 700;
      }

      #about,
      #legal,
      #press,
      #bots,
      #app {
        display: none;
      }

      #footerbox,
      #footermenu {
        font-size: 12pt;
        margin-bottom: 25px;
      }

      #footerbox {
        min-height: 60px;
      }

      #footermenu a {
        margin: 10px;
        text-decoration: none;
        cursor: pointer;
      }

      #footerbox ul {
        list-style-type: none;
        margin: 0 0 30px;
        padding: 0;
      }

      #footerbox li {
        line-height: 36pt;
      }

      #sharebuttons {
        margin-bottom: 25px;
      }

      #preresults,
      h2 {
        font-size: 15pt;
        font-weight: 400;
        text-transform: uppercase;
      }

      #queryspan,
      #rebox {
        font-size: 15pt;
        line-height: 17pt;
        padding: 0;
        margin: 0;
        border: 0;
      }

      #scoreinfo {
        display: inline-block;
        margin-bottom: 15px;
      }

      #querydiv {
        border: thin solid #ccc;
        float: left;
        padding: 8px;
      }

      #rebox {
        font-weight: 700;
        width: 200px;
        margin-left: 6px;
      }

      #rebox:focus {
        outline-width: 0;
      }

      #guess {
        width: 87px;
        height: 36px;
        background: url(data:image/gif;base64,);
        margin-top: 2px;
        margin-left: 10px;
        float: left;
      }

      #guess:hover {
        -webkit-box-shadow: 0 2px 2px rgba(0, 0, 0, 0.1);
        box-shadow: 0 2px 2px rgba(0, 0, 0, 0.1);
        background-position: -87px 0;
      }

      #failscontainer {
        z-index: 99;
        display: none;
        position: absolute;
        top: 280px;
        font-size: 300px;
        line-height: 230px;
        color: red;
        width: 100%;
        font-family: Impact, "Squada One", sans-serif;
        text-align: center;
      }

      .failx {
        border: 10px solid red;
        margin-right: 40px;
        display: inline-block;
      }

      #failures,
      #highscore,
      #roundnumber,
      #score {
        color: #498bf3;
        font-size: 15pt;
        float: left;
        clear: right;
        margin-right: 70px;
      }

      #score {
        margin-right: 0;
      }

      #scoreinfo span {
        font-weight: 700;
        font-size: 28pt;
      }

      #message {
        margin-left: 10px;
        margin-top: 6px;
      }

      #logo {
        display: block;
        width: 500px;
        height: 94.5px;
        margin: 0 auto;
        position: relative;
        left: -5px;
      }

      .otherthing,
      .score {
        display: inline-block;
      }

      #wrapper {
        margin: 0 auto;
        padding: 0;
      }

      #testdiv,
      #testdiv2 {
        width: 100%;
        height: 42px;
      }

      .otherthing,
      .score {
        margin-top: 10px;
      }

      .preanswer {
        background-color: #498bf3;
      }

      .caties,
      .oval {
        font-weight: 700;
        background-color: #f5f5f5;
      }

      .score {
        float: right;
        color: #498bf3;
        margin-right: 8px;
      }

      .otherthing {
        float: left;
        max-width: 260px;
        text-align: left;
        margin-left: 10px;
      }

      .otherthing a {
        text-decoration: none;
        color: #222;
      }

      .otherthing a:hover {
        text-decoration: underline;
      }

      #answerkey {
        width: 700px;
        margin: 0 auto 30px;
        /* margin: 0 auto 50px; */
      }

      #table1,
      #table2 {
        width: 350px;
        float: left;
        clear: right;
        border-collapse: collapse;
        border-left: thin #ccc solid;
        border-right: thin #ccc solid;
        font-size: 15pt;
      }

      #table1 td,
      #table2 td {
        border-bottom: thin #ccc solid;
        border-top: thin #ccc solid;
        height: 42px;
        padding: 0;
        margin: 0;
      }

      .answered {
        font-weight: 700;
      }

      .unanswered {
        margin: 0;
      }

      .oval {
        height: 36px;
        width: 60px;
        border: none;
        border-radius: 30px/18px;
        text-align: center;
        margin: auto;
        line-height: 35px;
      }

      .left {
        text-align: left;
      }

      .right {
        text-align: right;
      }

      #categories {
        text-align: center;
        margin-left: 15px;
      }

      #categories h2 {
        font-weight: 700;
      }

      #catwrap {
        height: 100px;
      }

      #starter {
        display: none;
      }

      .caties {
        display: inline-block;
        line-height: 22pt;
        margin-right: 15px;
        margin-bottom: 15px;
        font-size: 10pt;
        text-transform: capitalize;
        border-radius: 2px;
        -moz-border-radius: 2px;
        -webkit-border-radius: 2px;
        border: 1px solid #dbdbdb;
        width: 124px;
        height: 30px;
      }

      .caties:hover {
        -webkit-box-shadow: 0 2px 2px rgba(0, 0, 0, 0.1);
        box-shadow: 0 2px 2px rgba(0, 0, 0, 0.1);
        border-color: #c6c6c6;
      }

      #guessdiv {
        float: right;
      }

      #resize_wrapper {
        width: 100%;
      }

      @media screen and (max-width: 1000px) {
        #wrapper {
          transform: scale(0.75);
          transform-origin: top center;
        }
      }

      @media screen and (max-width: 700px) {
        #wrapper {
          transform: scale(0.55);
        }
        #resize_wrapper {
          width: 150%;
          margin-left: -25%;
        }
      }

      @media screen and (max-width: 500px) {
        #wrapper {
          transform: scale(1);
        }
        #table1 TD,
        #table2 td,
        #testdiv,
        #testdiv2,
        .oval {
          height: 24px;
        }
        #wrapper {
          width: 100%;
          margin: 0;
          padding: 0;
          min-width: 320px;
        }
        #logo {
          width: 90%;
          max-height: 55px;
          margin: -15px 5%;
        }
        #table1,
        #table2 {
          float: none;
          margin: 0 auto;
        }
        .oval {
          width: 45px;
          line-height: 26px;
        }
        .otherthing {
          padding-top: 0;
          margin-left: 5px;
        }
        .score {
          padding: 0;
          margin-right: 5px;
        }
        .otherthing,
        .score {
          margin-top: 5px;
        }
        #guess,
        body {
          margin: 0;
        }
        #message {
          padding: 0;
          width: 87px;
          height: 36px;
          line-height: 36px;
          margin: -1px 0 0;
        }
        #table1,
        #table2 {
          font-size: 10pt;
          width: 300px;
        }
        #catwrap {
          height: auto;
          margin-bottom: 5px;
        }
        #guessdiv {
          margin: 9px 0 0;
          padding-left: 4px;
        }
        #photobomber,
        h2 {
          font-size: 9pt;
        }
        #rebox {
          width: 100%;
          float: left;
          clear: left;
        }
        #querydiv {
          padding: 5px;
        }
        #queryspan,
        #rebox {
          font-size: 10pt;
          margin: 0;
          padding: 0;
        }
        #queryspan {
          float: left;
          width: 215px;
          overflow: hidden;
          white-space: nowrap;
        }
        #queryspan:after {
          content: "...";
        }
        #failures,
        #highscore,
        #roundnumber,
        #score {
          font-size: 9pt;
          float: left;
          margin-right: 12px;
        }
        body {
          overflow-x: hidden;
        }
        #scoreinfo span {
          font-size: 18pt;
        }
        #footerbox,
        #footermenu {
          font-size: 10pt;
        }
        #categories {
          max-width: 420px;
          margin: 0 auto;
        }
        .caties {
          margin-bottom: 10px;
          margin-right: 1px;
          margin-left: 1px;
          line-height: 19pt;
          width: 65px;
          height: 24px;
        }
        #score {
          margin-right: 0;
        }
        #answerkey {
          margin-bottom: 15px;
          width: auto;
        }
        #footerbox {
          padding: 0 15px;
          min-height: 0;
        }
        #scoreinfo {
          display: inline-block;
          margin-bottom: 20px;
        }
        #sharebuttons {
          padding: 0;
          width: auto;
          margin-right: -20px;
        }
        #failscontainer {
          font-size: 150px;
          line-height: 110px;
          left: 0;
          right: 0;
          top: 80px;
          margin: 0 auto;
          width: 330px;
        }
        .failx {
          margin-left: 8px;
          margin-right: 8px;
        }
        #webby-pv-2014-bug {
          display: none;
        }
      }

      #flag {
        margin-top: -70px;
        position: relative;
        text-indent: 450px;
      }

      .botimg {
        margin: 15px;
        width: 70px;
      }

      #blue_overlay {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 99;
        text-align: center;
        background-color: #498bf3;
        display: none;
      }

      #blue_text_box {
        position: relative;
        display: block;
        top: 25%;
        width: 90%;
        margin: -1.5rem auto;
        color: white;
        max-width: 40rem;
        font-size: 1.5rem;
      }

      #ok {
        color: white;
        position: relative;
        display: block;
        margin: 2rem auto;
        border: thick white solid;
        padding: 1rem 0;
        width: 50%;
        cursor: pointer;
      }
    </style>
